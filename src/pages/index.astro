---
// THE ISLAND CUT, one page. The photograph is the fold, the house speaks once, the stones are records on a table.
// Phase 1 of look/BRIEF-10-FEATURES.md: the viewing room (2), the comparison tray (4), the passport (6) and a request
// based viewing with a specialist (7). Phase 2 (31 Oct 2026, the seven reference clips): a ring that turns with the
// scroll in the hero, a ring that comes apart into its three choices, a ring builder with no price, and a ring box
// that opens on a tap. The hero is ChatGPT's opening of 1 Nov 2026, taken whole: sixty GENERATED frames of one ring that turns with the
// scroll (Thulaib's call that day), labelled Generated sample. Every other clip and photograph is licensed stock, labelled Sample. All listed in
// public/assets/SOURCES.md. Every real world value is in src/config.js.
// Every record on the page is a sample and says so. Every door ends in a prefilled WhatsApp message.
import Layout from '../layouts/Layout.astro';
import Journey from '../components/Journey.astro';
import '../styles/atelier.css';
import Icon from '../components/Icon.astro';
import { SITE, LINKS, VIEWS, wa } from '../config.js';
import { url } from '../scripts/icon.js';
import data from '../data/stones.json';
import builder from '../data/builder.json';
const stones = data.stones;
const first = stones[0];
const photo = s => s.photo ? { src: url(`assets/photos/${s.photo.file}-1600.webp`), srcset: `${url(`assets/photos/${s.photo.file}-800.webp`)} 800w, ${url(`assets/photos/${s.photo.file}-1600.webp`)} 1600w` } : null;
const size = s => `${s.mm[0]} by ${s.mm[1]} by ${s.mm[2]} mm`;
const facts = s => `${s.carat.toFixed(2)} ct, ${size(s)}, ${s.treatment.value.toLowerCase()}`;
const askText = s => `Hello, from the website. I am asking about stone ${s.ref} (${s.title}, ${s.carat.toFixed(2)} ct).`;
const motion = f => url(`assets/motion/${f}`);
const payload = { whatsapp: SITE.whatsapp, slots: SITE.slots, views: VIEWS, stones, builder };
---
<Layout>
<header class="nav"><div class="wrap in">
  <a class="brand" href="#top" data-top>{SITE.name}<span>Gems &amp; personal commissions</span></a>
  <nav class="links" aria-label="Sections">{LINKS.map(l => <a href={l.href}>{l.label}</a>)}</nav>
  <button class="view" type="button" id="nav-book" data-request>Book a viewing <Icon name="out" /></button>
</div></header>

<main id="top">
<Journey />
<section class="house atelier-house" id="house" aria-label="The house"><div class="wrap">
  <div data-atelier-reveal><span class="atelier-kicker">A more personal perspective</span><h2>First, the stone.<br>Then, <em>your story.</em></h2></div>
  <div class="house-aside" data-atelier-reveal><p>Begin with a colour. Stay for the details. Explore a stone closely, then imagine the piece it could become.</p><a class="atelier-link" href="#stones">Explore the collection <Icon name="out" /></a><small>A design concept. Sample stones and illustrative pieces are clearly identified below.</small></div>
</div></section>

<section class="wrap section" id="stones" aria-labelledby="stones-h">
  <header>
    <div><span class="atelier-kicker">01 / Your palette</span><h2 id="stones-h">Find your <em>colour.</em></h2><p class="note">Four possibilities. One personal starting point.</p></div>
    <p class="collection-note">Choose a colour.<br>Make it your own.</p>
  </header>
  <div class="stones">
    {stones.map(s => <article class="stone" data-ref={s.ref} data-atelier-reveal>
      <div class="frame">
        {s.photo ? <img src={photo(s).src} srcset={photo(s).srcset} sizes="(min-width:900px) 25vw, 100vw" alt={s.photo.alt} width={s.photo.w} height={s.photo.h} style={`object-position:${s.photo.focus}`} loading="lazy"> : <div class="empty"><Icon name="nophoto" /><strong>Not yet photographed</strong><p>This record has no picture until the stone is shot in daylight.</p></div>}
      </div>
      <div class="meta">
        <div class="ref"><span>{s.ref}</span><span class="tag">Colour study</span></div>
        <h3>{s.title}</h3>
        <div class="row">
          <button type="button" data-passport={s.ref}>Details</button>
          <button type="button" data-room={s.ref}>Explore</button>
          <button type="button" data-compare={s.ref} aria-pressed="false">Compare</button>
        </div>
      </div>
    </article>)}
  </div>
  <p class="note colour-disclaimer">Illustrative 3D colour studies, not inventory photographs. Details and availability must be confirmed with the house.</p>
</section>

<section class="band section" id="viewing" aria-labelledby="viewing-h"><div class="wrap">
  <header data-atelier-reveal><div><span class="atelier-kicker">02 / A closer look</span><h2 id="viewing-h">Compare.<br><em>Consider. Choose.</em></h2><p class="note">Explore the illustrative colour studies and sample specifications. Request actual photographs and documentation before choosing a stone.</p></div></header>
  <div class="room">
    <div class="picker" role="group" aria-label="Choose a stone">{stones.map((s, i) => <button type="button" class="chip" data-pick={s.ref} aria-pressed={i === 0 ? 'true' : 'false'}>{s.ref}</button>)}</div>
    <div>
      <div class="tabs" role="tablist" aria-label="Light">{VIEWS.map((v, i) => <button type="button" class="tab" role="tab" data-view={v.key} aria-selected={i === 0 ? 'true' : 'false'} id={`tab-${v.key}`}><Icon name={v.icon} />{v.label}</button>)}</div>
      <figure class="stage" id="stage" role="tabpanel">
        <div class="frame">
          <img id="stage-img" src={photo(first).src} srcset={photo(first).srcset} sizes="(min-width:900px) 58vw, 100vw" alt={first.photo.alt} width={first.photo.w} height={first.photo.h} style={`object-position:${first.photo.focus}`} loading="lazy">
          <div class="empty" id="stage-empty" hidden><Icon name="nophoto" /><strong id="stage-empty-h">Not captured yet</strong><p id="stage-empty-p"></p></div>
        </div>
        <figcaption id="stage-cap">{first.photo.credit}</figcaption>
      </figure>
    </div>
    <div class="beside">
      <div><p class="note" id="room-ref">{first.ref}</p><h3 id="room-title">{first.title}</h3></div>
      <dl id="room-facts"></dl>
      <div class="ask">
        <a class="door fill" id="room-ask" href={wa(askText(first))} target="_blank" rel="noopener"><Icon name="b-whatsapp" />Request another view</a>
        <div class="pair"><button class="door" type="button" id="room-passport">Passport</button><button class="door" type="button" id="room-compare" aria-pressed="false">Compare</button></div>
        <p class="note">A view you ask for is shown on a call or sent as a clip, in daylight, report in frame.</p>
      </div>
    </div>
  </div>
</div></section>

<section class="wrap section" id="jewellery" aria-labelledby="jewellery-h">
  <figure class="atelier-ring-study" data-atelier-reveal><img src={motion('hero-ring/poster-1200.webp')} width="1200" height="1200" alt="Illustrative sapphire ring design in yellow gold" loading="lazy" /><figcaption>Generated design study · Not a finished piece or stock item</figcaption></figure>
  <div class="atelier-jewel-copy" data-atelier-reveal>
    <span class="atelier-kicker">03 / Personal commissions</span><h2 id="jewellery-h">Not off a shelf.<br><em>Around you.</em></h2>
    <p>A ring, a pendant, a piece with a meaning only you know. Start with an idea and explore the stone, setting and metal together.</p>
    <button class="atelier-link" type="button" data-build>Begin your design <Icon name="out" /></button>
    <p class="note">The ring shown is an illustration. Actual finished-piece photographs and available options are to be confirmed by the house.</p>
  </div>
</section>

<section class="band section" id="bespoke" aria-labelledby="bespoke-h"><div class="wrap">
  <header data-atelier-reveal><div><span class="atelier-kicker">04 / The proposed journey</span><h2 id="bespoke-h">From a possibility<br>to <em>something personal.</em></h2><p class="note">A considered conversation, one decision at a time.</p></div></header>
  <ol class="steps">
    <li data-atelier-reveal><div><strong>Find your stone.</strong><p>Explore colour, proportions and available documentation. Ask to see the stone in different light.</p></div></li>
    <li data-atelier-reveal><div><strong>Make it yours.</strong><p>Discuss the setting, metal and personal details. Confirm the design and terms before commissioning.</p></div></li>
    <li data-atelier-reveal><div><strong>See it come together.</strong><p>Agree how the finished piece will be reviewed, and confirm delivery arrangements directly with the house.</p></div></li>
  </ol>
  <div class="doors" style="margin-top:24px"><button class="door fill" type="button" id="bespoke-build" data-build>Build your ring</button><a class="door" id="bespoke-wa" href={wa('Hello, from the website. I would like to create a piece around a stone.')} target="_blank" rel="noopener"><Icon name="b-whatsapp" />Create your piece</a></div>
  <p class="note" style="margin-top:16px">The steps are shown as proposed. The house confirms each one before launch.</p>
</div></section>

<section class="wrap section" id="craft" aria-labelledby="craft-h">
  <header data-atelier-reveal><div><span class="atelier-kicker">05 / Considered details</span><h2 id="craft-h">Beauty,<br><em>with clarity.</em></h2><p class="note">The questions are part of choosing well.</p></div></header>
  <div class="atelier-questions" data-atelier-reveal>
    <details><summary><span>01</span> What should I ask about a stone?<i aria-hidden="true">+</i></summary><p>Ask about its weight, dimensions, treatment and available laboratory documentation. The sample passports on this site distinguish supplied information from details that are not documented.</p></details>
    <details><summary><span>02</span> Can I see it in different light?<i aria-hidden="true">+</i></summary><p>Use the viewing room to explore the available views. If a photograph or rotation clip is missing, request it directly rather than relying on a simulated view.</p></details>
    <details><summary><span>03</span> Where does a personal piece begin?<i aria-hidden="true">+</i></summary><p>The design builder creates a starting brief, not a purchase. Confirm the stone, setting, metal, engraving, price and production timing with the house before making a commitment.</p></details>
    <details><summary><span>04</span> Are the pieces here available to buy?<i aria-hidden="true">+</i></summary><p>This is a concept site with sample records and generated gemstone and ring studies. It does not represent confirmed stock. Availability and all commercial details must be verified directly.</p></details>
  </div>
</section>

<section class="band section spec" id="contact" aria-labelledby="contact-h"><div class="wrap in">
  <div data-atelier-reveal><span class="atelier-kicker">Your next chapter</span><h2 id="contact-h">Let’s find<br><em>your stone.</em></h2><p>Bring a favourite colour, an occasion, or simply a question. Start a conversation about what comes next.</p><p class="note">A request is not a confirmed appointment or a reservation.</p></div>
  <div class="doors"><button class="door fill" type="button" id="spec-time" data-request>Request a time</button><a class="door" id="spec-wa" href={wa('Hello, from the website. I would like to speak to a specialist about the stones on the table.')} target="_blank" rel="noopener"><Icon name="b-whatsapp" />WhatsApp a specialist</a></div>
</div></section>
</main>

<footer class="wrap footer">
  <p class="atelier-signature" aria-hidden="true" data-atelier-reveal>The Island Cut</p>
  <a class="brand" href="#top" data-top>{SITE.name}</a>
  <nav class="flinks" aria-label="Sections">{LINKS.map(l => <a href={l.href}>{l.label}</a>)}<a id="foot-wa" href={wa('Hello, from the website. I have a question for the house.')} target="_blank" rel="noopener">WhatsApp</a></nav>
  <p class="fine">Working name, concept site by Business Booster. Gemstones and rings are generated design studies, not inventory photographs. Specifications are sample data, not verified stock or certification claims.</p>
</footer>

<aside class="tray" id="tray" data-on="false" data-open="false" aria-label="Stones to compare">
  <div class="bar">
    <div class="what"><strong id="tray-what">Comparing 0 of 3</strong><span id="tray-refs"></span></div>
    <div class="acts"><button class="door" type="button" id="tray-open" aria-expanded="false">Open</button><button class="door quiet" type="button" id="tray-clear">Clear</button></div>
  </div>
  <div class="body">
    <p class="warn" id="tray-warn" hidden>The tray holds three. Remove one to add another.</p>
    <table class="cmp" id="cmp"><thead><tr id="cmp-head"></tr></thead><tbody id="cmp-body"></tbody></table>
    <label class="check"><input type="checkbox" id="diff">Show differences only</label>
    <div class="doors"><button class="door fill" type="button" id="tray-spec" data-request>View these with a specialist</button></div>
    <p class="note">Saved on this phone or computer only, not on any account. A shortlist is not a reservation and holds no stone.</p>
  </div>
</aside>

<dialog id="passport" class="pp" aria-labelledby="pp-title"><div class="sheet">
  <div class="top"><div><p class="note" id="pp-ref"></p><h2 id="pp-title"></h2></div><button class="x" type="button" id="pp-close" aria-label="Close the passport"><Icon name="close" /></button></div>
  <div class="scroll">
    <p><span class="tag">Sample data</span></p>
    <div class="frame"><img id="pp-img" src="" alt="" width="1600" height="1200" loading="lazy"><div class="empty" id="pp-empty" hidden><Icon name="nophoto" /><strong>Not yet photographed</strong><p>No picture until the stone is shot in daylight.</p></div></div>
    <p class="note" id="pp-cap"></p>
    <dl id="pp-dl"></dl>
    <div><p class="note" style="margin-bottom:8px">Views captured</p><ul class="views" id="pp-views"></ul></div>
  </div>
  <div class="acts">
    <button class="door fill" type="button" id="pp-spec" data-request>View with a specialist</button>
    <div class="pair"><button class="door" type="button" id="pp-compare" aria-pressed="false">Compare</button><a class="door" id="pp-ask" href="#" target="_blank" rel="noopener"><Icon name="b-whatsapp" />Ask about it</a></div>
    <button class="door quiet" type="button" data-close>Close</button>
  </div>
</div></dialog>

<dialog id="request" class="req" aria-labelledby="req-title" data-sent="false"><div class="sheet">
  <div class="top"><h2 id="req-title">Request a time with a specialist</h2><button class="x" type="button" id="req-close" aria-label="Close the request"><Icon name="close" /></button></div>
  <div class="scroll">
    <div><p class="note" style="margin-bottom:8px">Stones to see</p><div class="chips" id="req-stones"></div></div>
    <div class="when">
      <div class="field"><label for="req-day">Day</label><div class="select"><select id="req-day"></select><Icon name="calendar" /></div></div>
      <div class="field"><label for="req-time">Time, Colombo clock</label><div class="select"><select id="req-time"></select><Icon name="clock" /></div></div>
      <p class="times"><strong id="req-local"></strong><span id="req-zone"></span></p>
    </div>
    <p class="note">A video call in daylight, report in frame. A person confirms the time by reply. A viewing does not reserve a stone.</p>
    <p class="done" id="req-done">Your request is open in WhatsApp. Send it there and a person confirms the time. The stones stay on the table until then.</p>
  </div>
  <div class="acts">
    <a class="door fill" id="req-send" href="#" target="_blank" rel="noopener"><Icon name="b-whatsapp" />Request a time</a>
    <button class="door quiet" type="button" data-close>Not now</button>
  </div>
</div></dialog>

<dialog id="builder" class="bld" aria-labelledby="bld-title" data-step="setting"><div class="sheet">
  <div class="top"><div><p class="note" id="bld-step"></p><h2 id="bld-title"></h2></div><button class="x" type="button" id="bld-close" aria-label="Close the builder"><Icon name="close" /></button></div>
  <div class="scroll" id="bld-body"></div>
  <div class="acts" id="bld-acts"></div>
</div></dialog>

<script type="application/json" id="payload" set:html={JSON.stringify(payload)}></script>
<script src="../scripts/site.js"></script>
</Layout>
