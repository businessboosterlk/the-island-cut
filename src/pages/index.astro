---
// THE ISLAND CUT, one page. The photograph is the fold, the house speaks once, the stones are records on a table.
// Phase 1 of look/BRIEF-10-FEATURES.md: the viewing room (2), the comparison tray (4), the passport (6) and a request
// based viewing with a specialist (7). Phase 2 (31 Oct 2026, the seven reference clips): a ring that turns with the
// scroll in the hero, a ring that comes apart into its three choices, a ring builder with no price, and a ring box
// that opens on a tap. The hero was rebuilt on 1 Nov 2026 on three GENERATED stills of one ring (Thulaib's call that
// day), labelled Generated sample. Every other clip and photograph is licensed stock, labelled Sample. All listed in
// public/assets/SOURCES.md. Every real world value is in src/config.js.
// Every record on the page is a sample and says so. Every door ends in a prefilled WhatsApp message.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { SITE, LINKS, VIEWS, wa } from '../config.js';
import { url } from '../scripts/icon.js';
import data from '../data/stones.json';
import builder from '../data/builder.json';
const stones = data.stones;
const first = stones[0];
const photo = s => s.photo ? { src: url(`assets/photos/${s.photo.file}-1600.webp`), srcset: `${url(`assets/photos/${s.photo.file}-800.webp`)} 800w, ${url(`assets/photos/${s.photo.file}-1600.webp`)} 1600w` } : null;
const size = s => `${s.mm[0]} by ${s.mm[1]} by ${s.mm[2]} mm`;
const facts = s => `${s.carat.toFixed(2)} ct, ${size(s)}, ${s.treatment.value.toLowerCase()}`;
const askText = s => `Hello, from the website. I am asking about stone ${s.ref} (${s.title}, ${s.carat.toFixed(2)} ct).`;
const motion = f => url(`assets/motion/${f}`);
// THE HERO (clip 5, rebuilt 1 Nov 2026): three generated stills of ONE ring. The first arrives large and tilted and
// settles in the centre, then each scroll stage swaps the picture, no morph, and its line lands. The stage starts at
// `at` of the scroll travel. Generated on 31 Oct 2026 in Canva, labelled on the page; the house's own photographs replace them.
const STILLS = [
  { file: 'lying', at: 0, alt: 'Generated sample: a sapphire ring in yellow gold, seen whole on a pale ground', line: 'The stone, chosen loose and in daylight.' },
  { file: 'upright', at: 0.34, alt: 'Generated sample: the same ring square to the camera, the stone filling the frame', line: 'The setting, agreed on a drawing first.' },
  { file: 'macro', at: 0.67, alt: 'Generated sample: the sapphire very close, every facet in view', line: 'Seen this close on a call, before anyone talks about money.' },
];
const payload = { whatsapp: SITE.whatsapp, slots: SITE.slots, views: VIEWS, stones, builder };
---
<Layout>
<header class="nav"><div class="wrap in">
  <a class="brand" href="#top" data-top>{SITE.name}</a>
  <nav class="links" aria-label="Sections">{LINKS.map(l => <a href={l.href}>{l.label}</a>)}</nav>
  <button class="door" type="button" id="nav-book" data-request>Book a viewing</button>
</div></header>

<main id="top">
<section class="wrap hero" id="hero" aria-label="A ring that arrives, then is seen three ways">
  <div class="track" id="hero-track"><div class="scene" id="hero-stage" data-entered="false">
    <figure class="turn" id="turn" data-stages={STILLS.length} data-stage="0">
      <div class="box">
        {STILLS.map((s, i) => <img class="still" id={`hero-still-${i}`} src={motion(`hero-ai/${s.file}-800.webp`)} srcset={[480, 800, 1200, 1600].map(w => `${motion(`hero-ai/${s.file}-${w}.webp`)} ${w}w`).join(', ')} sizes="(min-width:900px) 56vw, 100vw" alt={s.alt} width="1456" height="1088" fetchpriority={i ? 'low' : 'high'} decoding="async" aria-current={i ? undefined : 'true'} />)}
      </div>
      <figcaption id="hero-cap"><span class="tag">Generated sample</span><span>Three pictures of one ring, until the house's own photographs arrive.</span></figcaption>
    </figure>
    <div class="copy">
      <p class="eyebrow">{SITE.tagline}</p>
      <h1>An extraordinary stone. A piece <em>entirely yours.</em></h1>
      <ol class="words" id="hero-words" aria-label="What changes as the ring is seen three ways">
        {STILLS.map((s, i) => <li data-at={s.at} aria-current={i ? undefined : 'true'}>{s.line}</li>)}
      </ol>
      <div class="doors"><a class="door fill" href="#stones">Explore gemstones</a><a class="door" href="#bespoke">Create your piece</a></div>
    </div>
  </div></div>
  <p class="lead">{SITE.description}</p>
</section>

<section class="house" aria-label="The house"><div class="wrap">
  <p>Every piece here begins with a stone, chosen loose, shown in daylight with its report in frame and only then set.</p>
  <small>The house's own words go here once they are given. Nothing above is a claim about its history.</small>
</div></section>

<section class="wrap section" id="stones" aria-labelledby="stones-h">
  <header>
    <div><h2 id="stones-h">Stones on the table this week</h2><p class="note">{stones.length} sample records. The photographs are licensed stock standing in for the house's own stones. Every fact says where it came from.</p></div>
    <p class="note">Nothing is priced on this page. Ask a specialist.</p>
  </header>
  <div class="stones">
    {stones.map(s => <article class="stone" data-ref={s.ref}>
      <div class="frame">
        {s.photo ? <img src={photo(s).src} srcset={photo(s).srcset} sizes="(min-width:900px) 25vw, 100vw" alt={s.photo.alt} width={s.photo.w} height={s.photo.h} style={`object-position:${s.photo.focus}`} loading="lazy"> : <div class="empty"><Icon name="nophoto" /><strong>Not yet photographed</strong><p>This record has no picture until the stone is shot in daylight.</p></div>}
      </div>
      <div class="meta">
        <div class="ref"><span>{s.ref}</span><span class="tag">Sample data</span></div>
        <h3>{s.title}</h3>
        <p class="facts">{facts(s)}</p>
        <div class="statuses"><span class="status" data-s={s.lab.status}>{s.lab.status}</span><span class="status" data-s={s.origin.status}>Origin: {s.origin.status}</span></div>
        <div class="row">
          <button type="button" data-passport={s.ref}>Passport</button>
          <button type="button" data-room={s.ref}>Viewing room</button>
          <button type="button" data-compare={s.ref} aria-pressed="false">Compare</button>
        </div>
      </div>
    </article>)}
  </div>
</section>

<section class="band section" id="viewing" aria-labelledby="viewing-h"><div class="wrap">
  <header><div><h2 id="viewing-h">The viewing room</h2><p class="note">Real light only. Every view is a photograph or a clip of this exact stone, never altered. Where a view has not been captured yet, it says so.</p></div></header>
  <div class="room">
    <div class="picker" role="group" aria-label="Choose a stone">{stones.map((s, i) => <button type="button" class="chip" data-pick={s.ref} aria-pressed={i === 0 ? 'true' : 'false'}>{s.ref}</button>)}</div>
    <div>
      <div class="tabs" role="tablist" aria-label="Light">{VIEWS.map((v, i) => <button type="button" class="tab" role="tab" data-view={v.key} aria-selected={i === 0 ? 'true' : 'false'} id={`tab-${v.key}`}><Icon name={v.icon} />{v.label}</button>)}</div>
      <figure class="stage" id="stage" role="tabpanel">
        <div class="frame">
          <img id="stage-img" src={photo(first).src} srcset={photo(first).srcset} sizes="(min-width:900px) 58vw, 100vw" alt={first.photo.alt} width={first.photo.w} height={first.photo.h} style={`object-position:${first.photo.focus}`} loading="lazy">
          <div class="empty" id="stage-empty" hidden><Icon name="nophoto" /><strong id="stage-empty-h">Not captured yet</strong><p id="stage-empty-p"></p></div>
        </div>
        <figcaption id="stage-cap">{first.photo.credit}</figcaption>
      </figure>
    </div>
    <div class="beside">
      <div><p class="note" id="room-ref">{first.ref}</p><h3 id="room-title">{first.title}</h3></div>
      <dl id="room-facts"></dl>
      <div class="ask">
        <a class="door fill" id="room-ask" href={wa(askText(first))} target="_blank" rel="noopener"><Icon name="b-whatsapp" />Request another view</a>
        <div class="pair"><button class="door" type="button" id="room-passport">Passport</button><button class="door" type="button" id="room-compare" aria-pressed="false">Compare</button></div>
        <p class="note">A view you ask for is shown on a call or sent as a clip, in daylight, report in frame.</p>
      </div>
    </div>
  </div>
</div></section>

<section class="wrap section" id="jewellery" aria-labelledby="jewellery-h">
  <header><div><h2 id="jewellery-h">Finished pieces</h2><p class="note">Pieces made around a stone from the table.</p></div></header>
  <div class="prose">
    <p>The house's finished pieces are photographed on the same ground as the stones, one piece to a frame, beside the stone and its report. None are on the page yet. Nothing is drawn or generated to fill the space.</p>
    <p><a class="door" href="#bespoke">Create your piece</a></p>
  </div>
</section>

<section class="section explode" id="customise" aria-labelledby="customise-h"><div class="wrap">
  <header><div><h2 id="customise-h">Every part of it, yours to choose</h2><p class="note">Scroll and the ring comes apart into the three choices you make. Scroll back and it is whole again.</p></div></header>
  <div class="track" id="explode-track"><div class="scene" id="explode" data-apart="false" style="--p:0">
    <div class="layers" role="img" aria-label="A ring in three parts: the stone, the setting and the band">
      <img class="layer l-stone" src={motion('layers/stone.webp')} alt="" width="1000" height="603" loading="lazy">
      <img class="layer l-setting" src={motion('layers/setting.webp')} alt="" width="1000" height="603" loading="lazy">
      <img class="layer l-band" src={motion('layers/band.webp')} alt="" width="1000" height="603" loading="lazy">
    </div>
    <div class="beside">
      <ul class="parts">
        <li data-part="stone"><strong>The stone</strong><span>Yours to choose</span></li>
        <li data-part="setting"><strong>The setting</strong><span>Yours to choose</span></li>
        <li data-part="band"><strong>The band</strong><span>Yours to choose</span></li>
      </ul>
      <div class="doors"><button class="door fill" type="button" id="customise-build" data-build>Build your ring</button></div>
      <p class="cap"><span class="tag">Sample photograph</span><span>A licensed photograph cut into three layers by hand. Nothing is drawn or generated.</span></p>
    </div>
  </div></div>
</div></section>

<section class="band section" id="bespoke" aria-labelledby="bespoke-h"><div class="wrap">
  <header><div><h2 id="bespoke-h">A piece built around your stone</h2><p class="note">Three steps, each one agreed with you before the next.</p></div></header>
  <ol class="steps">
    <li><div><strong>Choose the stone</strong><p>In daylight, on a video call, with its report in frame. Nothing is bought unseen.</p></div></li>
    <li><div><strong>Agree the piece</strong><p>Ring, pendant or earrings, the metal and the setting. A drawing is agreed before anything is made.</p></div></li>
    <li><div><strong>See it finished</strong><p>The piece is photographed beside its stone and its report before it leaves.</p></div></li>
  </ol>
  <div class="doors" style="margin-top:24px"><button class="door fill" type="button" id="bespoke-build" data-build>Build your ring</button><a class="door" id="bespoke-wa" href={wa('Hello, from the website. I would like to create a piece around a stone.')} target="_blank" rel="noopener"><Icon name="b-whatsapp" />Create your piece</a></div>
  <p class="note" style="margin-top:16px">The steps are shown as proposed. The house confirms each one before launch.</p>
</div></section>

<section class="wrap section" id="craft" aria-labelledby="craft-h">
  <header><div><h2 id="craft-h">Our craft</h2></div></header>
  <div class="prose">
    <p>This paragraph is the house's to write: where its stones come from, who cuts them and how a piece is made. Nothing is written here on its behalf.</p>
    <p>No year, no cutter's name and no count appears on this page until the house gives it.</p>
  </div>
</section>

<section class="wrap section close" id="close" aria-labelledby="close-h">
  <header><div><h2 id="close-h">When it is ready, it comes to you in a box</h2><p class="note">Tap the box.</p></div></header>
  <div class="boxstage" id="box" data-open="false">
    <div class="frame box-frame">
      <video id="box-loop" muted loop playsinline preload="none" poster={motion('box/box-loop.webp')} width="960" height="540" aria-label="A ring box, sample footage"><source src={motion('box/box-loop.mp4')} type="video/mp4"></video>
      <video id="box-open" muted playsinline preload="none" poster={motion('box/box-open.webp')} width="960" height="540" aria-label="The box opens on the ring, sample footage" hidden><source src={motion('box/box-open.mp4')} type="video/mp4"></video>
      <button class="lid" type="button" id="box-tap" data-box="open" aria-label="Open the box"><span class="word">Yours</span></button>
    </div>
    <div class="reveal" id="box-reveal" hidden>
      <p>A time with a specialist, whenever you are ready.</p>
      <div class="doors"><button class="door fill" type="button" id="close-request" data-request>Request a time</button></div>
    </div>
    <p class="cap"><span class="tag">Sample footage</span><span>Two licensed clips of a ring box. The reference turns a closed box and opens it in one shot. No free clip does both, so this demo loops the box and cuts to the open shot on the tap.</span></p>
  </div>
</section>

<section class="band section spec" id="contact" aria-labelledby="contact-h"><div class="wrap in">
  <div><h2 id="contact-h">A specialist shows you these exact stones</h2><p>Choose up to three and a person turns each one in daylight on a call, report in frame. A viewing does not reserve a stone. Nothing is priced on this page.</p></div>
  <div class="doors"><button class="door fill" type="button" id="spec-time" data-request>Request a time</button><a class="door" id="spec-wa" href={wa('Hello, from the website. I would like to speak to a specialist about the stones on the table.')} target="_blank" rel="noopener"><Icon name="b-whatsapp" />WhatsApp a specialist</a></div>
</div></section>
</main>

<footer class="wrap footer">
  <a class="brand" href="#top" data-top>{SITE.name}</a>
  <nav class="flinks" aria-label="Sections">{LINKS.map(l => <a href={l.href}>{l.label}</a>)}<a id="foot-wa" href={wa('Hello, from the website. I have a question for the house.')} target="_blank" rel="noopener">WhatsApp</a></nav>
  <p class="fine">Working name, concept site by Business Booster, October 2026. The photographs are licensed stock standing in for the house's own stones. No price, no history and no report number on this page is real.</p>
</footer>

<aside class="tray" id="tray" data-on="false" data-open="false" aria-label="Stones to compare">
  <div class="bar">
    <div class="what"><strong id="tray-what">Comparing 0 of 3</strong><span id="tray-refs"></span></div>
    <div class="acts"><button class="door" type="button" id="tray-open" aria-expanded="false">Open</button><button class="door quiet" type="button" id="tray-clear">Clear</button></div>
  </div>
  <div class="body">
    <p class="warn" id="tray-warn" hidden>The tray holds three. Remove one to add another.</p>
    <table class="cmp" id="cmp"><thead><tr id="cmp-head"></tr></thead><tbody id="cmp-body"></tbody></table>
    <label class="check"><input type="checkbox" id="diff">Show differences only</label>
    <div class="doors"><button class="door fill" type="button" id="tray-spec" data-request>View these with a specialist</button></div>
    <p class="note">Saved on this phone or computer only, not on any account. A shortlist is not a reservation and holds no stone.</p>
  </div>
</aside>

<dialog id="passport" class="pp" aria-labelledby="pp-title"><div class="sheet">
  <div class="top"><div><p class="note" id="pp-ref"></p><h2 id="pp-title"></h2></div><button class="x" type="button" id="pp-close" aria-label="Close the passport"><Icon name="close" /></button></div>
  <div class="scroll">
    <p><span class="tag">Sample data</span></p>
    <div class="frame"><img id="pp-img" src="" alt="" width="1600" height="1200" loading="lazy"><div class="empty" id="pp-empty" hidden><Icon name="nophoto" /><strong>Not yet photographed</strong><p>No picture until the stone is shot in daylight.</p></div></div>
    <p class="note" id="pp-cap"></p>
    <dl id="pp-dl"></dl>
    <div><p class="note" style="margin-bottom:8px">Views captured</p><ul class="views" id="pp-views"></ul></div>
  </div>
  <div class="acts">
    <button class="door fill" type="button" id="pp-spec" data-request>View with a specialist</button>
    <div class="pair"><button class="door" type="button" id="pp-compare" aria-pressed="false">Compare</button><a class="door" id="pp-ask" href="#" target="_blank" rel="noopener"><Icon name="b-whatsapp" />Ask about it</a></div>
    <button class="door quiet" type="button" data-close>Close</button>
  </div>
</div></dialog>

<dialog id="request" class="req" aria-labelledby="req-title" data-sent="false"><div class="sheet">
  <div class="top"><h2 id="req-title">Request a time with a specialist</h2><button class="x" type="button" id="req-close" aria-label="Close the request"><Icon name="close" /></button></div>
  <div class="scroll">
    <div><p class="note" style="margin-bottom:8px">Stones to see</p><div class="chips" id="req-stones"></div></div>
    <div class="when">
      <div class="field"><label for="req-day">Day</label><div class="select"><select id="req-day"></select><Icon name="calendar" /></div></div>
      <div class="field"><label for="req-time">Time, Colombo clock</label><div class="select"><select id="req-time"></select><Icon name="clock" /></div></div>
      <p class="times"><strong id="req-local"></strong><span id="req-zone"></span></p>
    </div>
    <p class="note">A video call in daylight, report in frame. A person confirms the time by reply. A viewing does not reserve a stone.</p>
    <p class="done" id="req-done">Your request is open in WhatsApp. Send it there and a person confirms the time. The stones stay on the table until then.</p>
  </div>
  <div class="acts">
    <a class="door fill" id="req-send" href="#" target="_blank" rel="noopener"><Icon name="b-whatsapp" />Request a time</a>
    <button class="door quiet" type="button" data-close>Not now</button>
  </div>
</div></dialog>

<dialog id="builder" class="bld" aria-labelledby="bld-title" data-step="setting"><div class="sheet">
  <div class="top"><div><p class="note" id="bld-step"></p><h2 id="bld-title"></h2></div><button class="x" type="button" id="bld-close" aria-label="Close the builder"><Icon name="close" /></button></div>
  <div class="scroll" id="bld-body"></div>
  <div class="acts" id="bld-acts"></div>
</div></dialog>

<script type="application/json" id="payload" set:html={JSON.stringify(payload)}></script>
<script src="../scripts/site.js"></script>
</Layout>
