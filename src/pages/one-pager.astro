---
// HOUSE OF PRIYANTHA, the one pager (12 Nov 2026). Three parts: the hero still, the switching pieces, the close.
// The page stands alone: its styles and script are inline and every path is relative, so the built file opens
// with a double click and the home page's bundle is not touched. Black and white, one blue (#1e3f8f).
// Words are the SAFE set from the hero hand-over: nothing here promises a report, an origin, a price or a year.
// Icons are read from the lucide-static package at build time. Nothing is drawn by hand.
import { SITE } from '../config.js';
import arrowLeftRaw from 'lucide-static/icons/arrow-left.svg?raw';
import arrowRightRaw from 'lucide-static/icons/arrow-right.svg?raw';
import arrowDownRaw from 'lucide-static/icons/arrow-down.svg?raw';
import arrowOutRaw from 'lucide-static/icons/arrow-up-right.svg?raw';

const HOUSE = 'House of Priyantha';

// THE ONE LIST. A picture is one line: its file name (no ending) and the caption shown under it.
// The page looks for <file>.png, then .jpg, .jpeg, .webp in assets/one-pager/products/.
// A file that is missing is left out of the rotation; if none are there the slots show as marked empty slots.
// Captions name the piece only. Pink and yellow wait for bb_pending row 1843.
const PRODUCTS = [
  { file: 'p1-oval-sapphire', caption: 'Oval blue sapphire, loose' },
  { file: 'p2-cushion-sapphire', caption: 'Cushion blue sapphire, loose' },
  { file: 'p3-ring', caption: 'Oval sapphire ring' },
  { file: 'p4-earrings', caption: 'Sapphire stud earrings' },
  { file: 'p5-pendant', caption: 'Pear sapphire pendant' },
];

const ic = raw => raw.replace(/<!--[\s\S]*?-->/, '').replace(/class="[^"]*"/, 'class="ic" aria-hidden="true" focusable="false"').replace('stroke-width="2"', 'stroke-width="1.5"').trim();
const waBase = `https://wa.me/${SITE.whatsapp}?text=`;
const wa = text => waBase + encodeURIComponent(text);
const askText = caption => `Hello, from the ${HOUSE} page. I am asking about this piece: ${caption}.`;
const fontCss = `@font-face{font-family:'Cormorant Garamond';src:url(assets/fonts/cormorant.woff2) format('woff2');font-weight:300 700;font-style:normal;font-display:swap}` +
  `@font-face{font-family:'Instrument Sans';src:url(assets/fonts/instrument.woff2) format('woff2');font-weight:400 700;font-style:normal;font-display:swap}`;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{HOUSE}</title>
  <meta name="description" content="Sapphires cut by our own stonecutters, shown in daylight and lamplight before you decide.">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#f1f1f1">
  <meta name="color-scheme" content="light">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="assets/fonts/cormorant.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="assets/fonts/instrument.woff2">
  <style is:inline set:html={fontCss}></style>
  <style is:inline>
    :root{--ink:#141414;--mid:#6e6e6e;--line:#d9d9d9;--paper:#ffffff;--grey:#f1f1f1;--blue:#1e3f8f;--blue-2:#17316f;
      --display:'Cormorant Garamond',Georgia,'Times New Roman',serif;--body:'Instrument Sans',system-ui,-apple-system,sans-serif;
      --g:20px;--ease:cubic-bezier(.2,.7,.2,1)}
    *,*::before,*::after{box-sizing:border-box}
    html{-webkit-text-size-adjust:100%;text-size-adjust:100%;overflow-x:clip;background:var(--grey)}
    @media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
    body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 var(--body);-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent;overflow-x:clip}
    a{color:inherit;text-decoration:none}
    button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
    img{display:block;max-width:100%}
    h1,h2,p,figure{margin:0}
    h1,h2,p{text-wrap:balance}
    :focus-visible{outline:2px solid var(--ink);outline-offset:3px}
    .ic{width:18px;height:18px;flex:0 0 auto}
    .vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

    /* BUTTONS: square corners, one blue, an ink outline for the second door */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:52px;padding:0 24px;font:500 15px/1 var(--body);border:1px solid var(--ink);transition:background-color .18s var(--ease),color .18s var(--ease),border-color .18s var(--ease)}
    .btn.solid{background:var(--blue);border-color:var(--blue);color:#fff}
    @media (hover:hover){.btn:hover{background:var(--ink);color:#fff}.btn.solid:hover{background:var(--blue-2);border-color:var(--blue-2)}}
    .label{font-size:14px;color:var(--mid)}

    /* NAV */
    .nav{display:flex;align-items:center;justify-content:space-between;gap:16px;background:var(--grey);min-height:56px;padding:env(safe-area-inset-top) max(var(--g),env(safe-area-inset-right)) 0 max(var(--g),env(safe-area-inset-left))}
    .brand{font:500 22px/1 var(--display);letter-spacing:.005em;white-space:nowrap}
    .nav .links{display:none}
    .nav .door{display:inline-flex;align-items:center;min-height:44px;font:500 14px/1 var(--body);border-bottom:1px solid var(--ink)}
    .nav .door span{display:block;padding:6px 0}

    /* HERO, phone first: the picture cropped to the face, the stone and the hand, the words centred under it */
    .hero{background:var(--grey);position:relative}
    .hero .frame{position:relative;height:110.7vw;overflow:hidden}
    .hero .pic{position:absolute;width:182.86vw;aspect-ratio:3/2;left:-25vw;top:-7.14vw}
    .hero .pic img{width:100%;height:100%;max-width:none;object-fit:cover}
    .hero .tag{position:absolute;left:20%;bottom:11px;font-size:11px;line-height:1;color:#fff}
    .hero .words{text-align:center;padding:28px max(var(--g),env(safe-area-inset-right)) 44px max(var(--g),env(safe-area-inset-left))}
    .hero h1{font:400 clamp(36px,10.6vw,60px)/1 var(--display);letter-spacing:-.01em;margin:10px 0 14px}
    .hero h1 em{font-style:normal;color:var(--blue)}
    .hero .sub{font-size:16px;color:var(--ink);max-width:34ch;margin:0 auto 24px}
    .hero .doors{display:grid;gap:10px}
    .hero .marks{display:flex;flex-wrap:wrap;justify-content:center;list-style:none;margin:26px 0 0;padding:0;font-size:11px;color:var(--mid)}
    .hero .marks li{padding:0 8px;border-left:1px solid var(--line);line-height:1.2;margin:3px 0}
    .hero .marks li:first-child{border-left:0}

    /* THE SWITCHING PIECES: every picture sits in one fixed box and only its opacity changes, so nothing moves */
    .pieces{background:var(--paper);display:flex;flex-direction:column;gap:36px;padding:56px max(var(--g),env(safe-area-inset-right)) 64px max(var(--g),env(safe-area-inset-left))}
    .pieces .text{text-align:center}
    .pieces h2{font:400 34px/1.08 var(--display);letter-spacing:-.005em}
    .pieces .text p{font:400 20px/1.42 var(--display);max-width:30ch;margin:14px auto 26px}
    .pieces .text .btn{width:100%}
    .switch{order:-1;display:grid;grid-template-columns:48px minmax(0,1fr) 48px;align-items:center;row-gap:14px}
    .stage{grid-column:1/-1;grid-row:1;position:relative;aspect-ratio:1;background:var(--paper);touch-action:pan-y;user-select:none;-webkit-user-select:none}
    .slide{position:absolute;inset:0;opacity:0;transition:opacity .5s var(--ease)}
    .slide.on{opacity:1}
    .slide img{width:100%;height:100%;object-fit:contain;-webkit-user-drag:none}
    .slide .slot{display:none;position:absolute;inset:12%;border:1px solid var(--ink);flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;padding:16px}
    .slide .slot b{font:500 22px/1.1 var(--display)}
    .slide .slot small{font-size:12px;color:var(--mid);overflow-wrap:anywhere}
    .slide[data-state="empty"] .slot{display:flex}
    .slide[data-state="empty"] img,.slide:not([data-state]) img{display:none}
    .stage .tag{position:absolute;left:0;bottom:0;font-size:11px;line-height:1;color:var(--mid);opacity:0}
    .stage[data-shown="ok"] .tag{opacity:1}
    .caps{grid-column:1/-1;grid-row:2;display:grid;text-align:center}
    .cap{grid-area:1/1;font:500 21px/1.2 var(--display);opacity:0;transition:opacity .5s var(--ease)}
    .cap.on{opacity:1}
    .arrow{width:48px;height:48px;display:grid;place-items:center;border:1px solid var(--line);transition:border-color .18s var(--ease),background-color .18s var(--ease),color .18s var(--ease)}
    .arrow .ic{width:20px;height:20px}
    @media (hover:hover){.arrow:hover{border-color:var(--ink);background:var(--ink);color:#fff}}
    .arrow.prev{grid-column:1;grid-row:3}
    .arrow.next{grid-column:3;grid-row:3}
    .dots{grid-column:2;grid-row:3;display:flex;justify-content:center}
    .dots button{width:28px;height:44px;display:grid;place-items:center}
    .dots button::before{content:"";width:8px;height:8px;border:1px solid var(--ink);transition:background-color .18s var(--ease),border-color .18s var(--ease)}
    .dots button[aria-current="true"]::before{background:var(--blue);border-color:var(--blue)}
    .switch[data-count="1"] .arrow,.switch[data-count="1"] .dots{visibility:hidden}
    @media (prefers-reduced-motion:reduce){.slide,.cap{transition:none}}

    /* THE CLOSE */
    .close{background:var(--grey);text-align:center;padding:64px max(var(--g),env(safe-area-inset-right)) calc(36px + env(safe-area-inset-bottom)) max(var(--g),env(safe-area-inset-left))}
    .close h2{font:400 clamp(36px,10vw,56px)/1.02 var(--display);letter-spacing:-.01em;margin:10px 0 28px}
    .close .btn{width:100%}
    .close .foot{margin-top:48px;padding-top:18px;border-top:1px solid var(--line);display:grid;gap:8px;font-size:12px;color:var(--mid)}
    .close .foot .brand{font-size:19px;color:var(--ink)}

    /* TABLET: the whole picture, the words still centred under it */
    @media (min-width:600px){
      :root{--g:32px}
      .hero .frame{height:auto;aspect-ratio:3/2}
      .hero .pic{position:static;width:100%}
      .hero .tag{left:24.2%;bottom:4.5%}
      .hero .words{max-width:560px;margin:0 auto;padding-top:40px;padding-bottom:64px}
      .hero .doors{grid-template-columns:1fr 1fr}
      .hero .marks{font-size:13px}
      .hero .marks li{padding:0 14px}
      .pieces{padding-top:80px;padding-bottom:88px}
      .pieces .text .btn,.close .btn{width:auto}
      .switch{width:min(100%,560px);margin:0 auto}
    }

    /* DESK: its own layout. The picture is a stable box sized from the screen height, the words sit right of the hand,
       brand at the left gutter and the door at the right gutter. */
    @media (min-width:1100px){
      :root{--g:44px}
      .nav{position:absolute;z-index:2;top:0;left:0;right:0;min-height:64px;background:none}
      .nav .brand{color:#fff;font-size:24px}
      .nav .right{display:flex;align-items:center;gap:36px}
      .nav .links{display:flex;gap:28px;font-size:14px}
      .nav .links a{display:inline-flex;align-items:center;min-height:44px}
      @media (hover:hover){.nav .links a:hover{text-decoration:underline;text-underline-offset:5px}}
      .hero{--hh:clamp(560px,min(100svh,calc((100vw - 500px) / .98)),1040px);height:var(--hh);overflow:hidden}
      .hero .frame{position:absolute;aspect-ratio:auto;overflow:visible;height:calc(var(--hh) * 1.024);width:calc(var(--hh) * 1.536);left:calc(var(--hh) * -.1222);top:calc(var(--hh) * -.0089)}
      .hero .pic{width:100%;height:100%;-webkit-mask-image:linear-gradient(to right,#000 calc(100% - 110px),transparent);mask-image:linear-gradient(to right,#000 calc(100% - 110px),transparent)}
      .hero .words{position:absolute;margin:0;padding:0;text-align:left;left:calc(var(--hh) * .978 + 40px);right:var(--g);max-width:478px;top:50%;transform:translateY(-50%);container-type:inline-size}
      .hero h1{font-size:clamp(60px,22.6cqi,108px);line-height:.92;margin:18px 0 26px}
      .hero h1 span{display:block}
      .hero .sub{font-size:18px;max-width:30ch;margin:0 0 32px}
      .hero .doors{display:flex;flex-wrap:wrap;gap:12px}
      .hero .marks{justify-content:flex-start;margin-top:36px;font-size:13px}
      .hero .marks li:first-child{padding-left:0}

      .pieces{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:center;column-gap:48px;padding:120px var(--g) 128px}
      .pieces .text{text-align:left;max-width:440px}
      .pieces h2{font-size:52px;line-height:1.02}
      .pieces .text p{font-size:22px;margin:22px 0 34px}
      .switch{order:0;width:auto;margin:0;grid-template-columns:48px minmax(0,min(520px,62svh)) 48px;column-gap:32px;justify-content:center;row-gap:18px}
      .stage{grid-column:2}
      .caps{grid-column:2}
      .arrow.prev{grid-column:1;grid-row:1}
      .arrow.next{grid-column:3;grid-row:1}
      .dots{grid-column:2;grid-row:3}

      .close{text-align:left;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;column-gap:48px;padding:112px var(--g) 40px}
      .close h2{font-size:clamp(56px,6vw,88px);line-height:.96;margin:14px 0 0;max-width:12ch}
      .close .foot{grid-column:1/-1;margin-top:96px;grid-template-columns:auto 1fr;align-items:baseline;column-gap:32px}
      .close .foot p{text-align:right}
    }
  </style>
</head>
<body>
<header class="nav">
  <a class="brand" href="#top">{HOUSE}</a>
  <div class="right">
    <nav class="links" aria-label="Sections"><a href="#pieces">Sapphires</a></nav>
    <a class="door" href="#viewing"><span>Book a viewing</span></a>
  </div>
</header>

<main id="top">
<section class="hero" aria-label="The house">
  <div class="frame">
    <figure class="pic"><img src="assets/one-pager/hero-start.webp" width="1536" height="1024" alt="A woman in profile looks at an oval blue sapphire held between her finger and thumb" fetchpriority="high" decoding="async"></figure>
    <span class="tag">Generated sample</span>
  </div>
  <div class="words">
    <p class="label">Master stonecutters of Ceylon</p>
    <h1><span>It begins </span><span>with <em>blue.</em></span></h1>
    <p class="sub">Sapphires cut by our own stonecutters, shown in daylight and lamplight before you decide.</p>
    <div class="doors">
      <a class="btn solid" href="#pieces">Explore sapphires <Fragment set:html={ic(arrowDownRaw)} /></a>
      <a class="btn" href="#viewing">Book a private viewing</a>
    </div>
    <ul class="marks"><li>Master cutting</li><li>Seen in two lights</li><li>By private appointment</li></ul>
  </div>
</section>

<section class="pieces" id="pieces" aria-labelledby="pieces-h">
  <div class="text">
    <h2 id="pieces-h">Loose stones and finished pieces</h2>
    <p>Start with the stone or with the piece it could become. Ask about any of them and we will show it to you by appointment.</p>
    <a class="btn" data-ask href={wa(askText(PRODUCTS[0].caption))} target="_blank" rel="noopener">Ask about this piece <Fragment set:html={ic(arrowOutRaw)} /></a>
  </div>
  <div class="switch" data-switch data-wa={waBase} data-house={HOUSE} role="group" aria-roledescription="carousel" aria-label="Stones and pieces">
    <div class="stage" data-stage tabindex="0" aria-label="Piece on show. Use the left and right arrow keys to change it.">
      {PRODUCTS.map((p, i) => (
        <figure class={i === 0 ? 'slide on' : 'slide'} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
          <img data-base={`assets/one-pager/products/${p.file}`} alt={p.caption} width="1024" height="1024" decoding="async">
          <div class="slot"><b>Picture to come</b><small>{p.file}.png</small></div>
        </figure>
      ))}
      <span class="tag">Generated sample</span>
    </div>
    <div class="caps" aria-live="polite">
      {PRODUCTS.map((p, i) => <p class={i === 0 ? 'cap on' : 'cap'} data-cap aria-hidden={i === 0 ? 'false' : 'true'}>{p.caption}</p>)}
    </div>
    <button class="arrow prev" type="button" data-prev aria-label="Previous piece"><Fragment set:html={ic(arrowLeftRaw)} /></button>
    <div class="dots" data-dots></div>
    <button class="arrow next" type="button" data-next aria-label="Next piece"><Fragment set:html={ic(arrowRightRaw)} /></button>
  </div>
</section>

<section class="close" id="viewing" aria-labelledby="viewing-h">
  <div>
    <p class="label">By private appointment</p>
    <h2 id="viewing-h">See the stone before you decide.</h2>
  </div>
  <a class="btn solid" href={wa(`Hello, from the ${HOUSE} page. I would like to book a private viewing.`)} target="_blank" rel="noopener">Book a private viewing <Fragment set:html={ic(arrowOutRaw)} /></a>
  <div class="foot">
    <span class="brand">{HOUSE}</span>
    <p>The pictures on this page are generated samples, standing in for the house's own photographs.</p>
  </div>
</section>
</main>

<script is:inline>
(() => {
  const root = document.querySelector('[data-switch]');
  if (!root) return;
  const EXT = ['png', 'jpg', 'jpeg', 'webp'];
  const stage = root.querySelector('[data-stage]');
  const slides = [...root.querySelectorAll('[data-slide]')];
  const caps = [...root.querySelectorAll('[data-cap]')];
  const dots = root.querySelector('[data-dots]');
  const ask = document.querySelector('[data-ask]');
  let live = slides.map((_, i) => i);
  let at = 0;

  // Look for each picture under every ending. Nothing is shown until a file answers.
  const probe = slide => new Promise(done => {
    const img = slide.querySelector('img');
    let k = 0;
    const next = () => {
      if (k >= EXT.length) { slide.dataset.state = 'empty'; return done(false); }
      const src = img.dataset.base + '.' + EXT[k++];
      const t = new Image();
      t.onload = () => { img.src = src; slide.dataset.state = 'ok'; done(true); };
      t.onerror = next;
      t.src = src;
    };
    next();
  });

  const show = n => {
    at = (n + live.length) % live.length;
    const on = live[at];
    slides.forEach((s, i) => { s.classList.toggle('on', i === on); s.setAttribute('aria-hidden', i === on ? 'false' : 'true'); });
    caps.forEach((c, i) => { c.classList.toggle('on', i === on); c.setAttribute('aria-hidden', i === on ? 'false' : 'true'); });
    [...dots.children].forEach((d, i) => d.setAttribute('aria-current', i === at ? 'true' : 'false'));
    stage.dataset.shown = slides[on].dataset.state || '';
    root.dataset.at = String(at + 1);
    if (ask) ask.href = root.dataset.wa + encodeURIComponent('Hello, from the ' + root.dataset.house + ' page. I am asking about this piece: ' + caps[on].textContent + '.');
  };

  const build = () => {
    dots.textContent = '';
    live.forEach((idx, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', 'Piece ' + (i + 1) + ' of ' + live.length + ': ' + caps[idx].textContent);
      b.addEventListener('click', () => show(i));
      dots.appendChild(b);
    });
    root.dataset.count = String(live.length);
    show(0);
  };

  root.querySelector('[data-prev]').addEventListener('click', () => show(at - 1));
  root.querySelector('[data-next]').addEventListener('click', () => show(at + 1));
  root.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
    else if (e.key === 'Home') { e.preventDefault(); show(0); }
    else if (e.key === 'End') { e.preventDefault(); show(live.length - 1); }
  });

  // Swipe: a sideways drag of 40 px or more on the picture.
  let x0 = null, y0 = 0;
  stage.addEventListener('pointerdown', e => { x0 = e.clientX; y0 = e.clientY; });
  stage.addEventListener('pointerup', e => {
    if (x0 === null) return;
    const dx = e.clientX - x0, dy = e.clientY - y0;
    x0 = null;
    if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) show(at + (dx < 0 ? 1 : -1));
  });
  stage.addEventListener('pointercancel', () => { x0 = null; });

  build();
  Promise.all(slides.map(probe)).then(found => {
    const ok = found.map((f, i) => f ? i : -1).filter(i => i >= 0);
    if (ok.length) live = ok;
    build();
  });
})();
</script>
</body>
</html>
