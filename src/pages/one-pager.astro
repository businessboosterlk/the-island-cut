---
// HOUSE OF PRIYANTHA, the one pager (12 Nov 2026). Three parts: the hero still, the switching pieces, the close.
// The page stands alone: its styles and script are inline and every path is relative, so the built file opens
// with a double click and the home page's bundle is not touched. Black and white, one blue (#1e3f8f).
// Words are the SAFE set from the hero hand-over: nothing here promises a report, an origin, a price or a year.
// Icons are read from the lucide-static package at build time. Nothing is drawn by hand.
import { SITE } from '../config.js';
import arrowLeftRaw from 'lucide-static/icons/arrow-left.svg?raw';
import arrowRightRaw from 'lucide-static/icons/arrow-right.svg?raw';
import arrowDownRaw from 'lucide-static/icons/arrow-down.svg?raw';
import arrowOutRaw from 'lucide-static/icons/arrow-up-right.svg?raw';

const HOUSE = 'House of Priyantha';

// THE ONE LIST. A picture is one line: its file name (no ending) and the caption shown under it.
// The page looks for <file>.png, then .jpg, .jpeg, .webp in assets/one-pager/products/.
// A file that is missing is left out of the rotation; if none are there the slots show as marked empty slots.
// Captions name the piece only. Pink and yellow wait for bb_pending row 1843.
const PRODUCTS = [
  { file: 'p1-oval-sapphire', caption: 'Oval blue sapphire, loose', ref: 'HOP-001', shape: 'Oval', weight: '2.10 ct', treatment: 'Heated', report: 'Laboratory to be named' },
  { file: 'p2-cushion-sapphire', caption: 'Cushion blue sapphire, loose', ref: 'HOP-002', shape: 'Cushion', weight: '3.05 ct', treatment: 'Unheated', report: 'Laboratory to be named' },
  { file: 'p3-ring', caption: 'Oval sapphire ring', ref: 'HOP-003', shape: 'Oval', weight: '1.80 ct', treatment: 'Heated', report: 'Laboratory to be named' },
  { file: 'p4-earrings', caption: 'Sapphire stud earrings', ref: 'HOP-004', shape: 'Round', weight: '2 x 0.75 ct', treatment: 'Heated', report: 'Laboratory to be named' },
  { file: 'p5-pendant', caption: 'Pear sapphire pendant', ref: 'HOP-005', shape: 'Pear', weight: '2.40 ct', treatment: 'Unheated', report: 'Laboratory to be named' },
];
// STONE PASSPORT (13 Nov): ref, shape, weight, treatment and report above are SAMPLES, every one of them, and the card
// says so. Not one is a fact about the house's stock. Swap them for the house's own values when they arrive.
const PASS = [['ref', 'Reference'], ['shape', 'Shape'], ['weight', 'Weight'], ['treatment', 'Treatment'], ['report', 'Report']];

// THE RING, three steps on about three screens of scroll. The frames and the words are the site's own ring journey
// (src/components/Journey.astro, public/assets/motion/): the turn, the parts coming apart and the turn back to blue.
// The site's nine chapter script is not used here: this page runs a short clock of its own over the same frames.
const STEPS = [
  ['Look closer', 'See the details.', 'A quiet turn. A different perspective.'],
  ['Every part is a choice', 'Nothing generic. Entirely yours.', 'Choose the gemstone. Explore the setting. Choose your metal.'],
  ['Coming together', 'One stone. Your story.', 'The details find their place. A piece begins to feel like yours.'],
];
// WHAT DECIDES A SAPPHIRE. General gem knowledge, each line checked against the client's own guide
// (~/bb-consultancy/priyantha-gems/client-src/Made-Simple.txt). Nothing here describes this house's own stones.
const KNOW = [
  ['Colour', 'Usually the biggest part of the value. The best blues are strong and even without turning so dark that the stone loses its brightness.'],
  ['Clarity', 'Inclusions are not automatically a fault. What matters is whether they dull the stone or weaken it.'],
  ['Cut', 'How well the angles and proportions show the colour and send light back to the eye.'],
  ['Weight', 'Size counts alongside quality. Weight hidden in an overly deep stone adds to the scale and not to what you see.'],
  ['Treatment', 'Natural does not mean untreated. A natural sapphire may still have been heated and a buyer should always be told.'],
  ['Origin', 'Where a stone was mined can influence its value. It is one factor among several and it is hard to establish, even for a laboratory.'],
];
// THREE QUESTIONS BUYERS ASK (13 Nov). General gem knowledge only; no line describes this house's stock.
const ASKED = [
  ['Heated and unheated', 'Most sapphires sold today have been heated to improve their colour and clarity. It is an old, accepted practice and the result is permanent. An unheated stone of the same quality is rarer and usually costs more, so ask for the treatment in writing.'],
  ['Ceylon and other origins', 'Ceylon is the old name for Sri Lanka, one of the oldest sources of sapphire and long known for bright, lively blues. Kashmir, Burma and Madagascar are other well known sources. Origin adds to a stone only when the stone itself is good.'],
  ['Cut styles', 'Oval and cushion are the most common shapes because they keep the most of the rough crystal. Round, pear and emerald cuts are made too. Faceted stones are cut to return light. A cabochon is a smooth dome, the cut used for star sapphires.'],
];
const ic = raw => raw.replace(/<!--[\s\S]*?-->/, '').replace(/class="[^"]*"/, 'class="ic" aria-hidden="true" focusable="false"').replace('stroke-width="2"', 'stroke-width="1.5"').trim();
const waBase = `https://wa.me/${SITE.whatsapp}?text=`;
const wa = text => waBase + encodeURIComponent(text);
const askText = caption => `Hello, from the ${HOUSE} page. I am asking about this piece: ${caption}.`;
const fontCss = `@font-face{font-family:'Cormorant Garamond';src:url(assets/fonts/cormorant.woff2) format('woff2');font-weight:300 700;font-style:normal;font-display:swap}` +
  `@font-face{font-family:'Instrument Sans';src:url(assets/fonts/instrument.woff2) format('woff2');font-weight:400 700;font-style:normal;font-display:swap}`;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{HOUSE}</title>
  <meta name="description" content="Sapphires cut by our own stonecutters, shown in daylight and lamplight before you decide.">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#f1f1f1">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <meta name="color-scheme" content="light">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="assets/fonts/cormorant.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="assets/fonts/instrument.woff2">
  <style is:inline set:html={fontCss}></style>
  <style is:inline>
    :root{--ink:#141414;--mid:#6e6e6e;--line:#d9d9d9;--paper:#ffffff;--grey:#f1f1f1;--blue:#1e3f8f;--blue-2:#17316f;
      --display:'Cormorant Garamond',Georgia,'Times New Roman',serif;--body:'Instrument Sans',system-ui,-apple-system,sans-serif;
      --g:20px;--ease:cubic-bezier(.2,.7,.2,1)}
    *,*::before,*::after{box-sizing:border-box}
    html{-webkit-text-size-adjust:100%;text-size-adjust:100%;overflow-x:clip;background:var(--grey)}
    @media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
    body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 var(--body);-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent;overflow-x:clip}
    a{color:inherit;text-decoration:none}
    button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}
    img{display:block;max-width:100%}
    h1,h2,p,figure{margin:0}
    h1,h2,p{text-wrap:balance}
    :focus-visible{outline:2px solid var(--ink);outline-offset:3px}
    .ic{width:18px;height:18px;flex:0 0 auto}
    .vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

    /* BUTTONS: square corners, one blue, an ink outline for the second door */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:52px;padding:0 24px;font:500 15px/1 var(--body);border:1px solid var(--ink);transition:background-color .18s var(--ease),color .18s var(--ease),border-color .18s var(--ease)}
    .btn.solid{background:var(--blue);border-color:var(--blue);color:#fff}
    @media (hover:hover){.btn:hover{background:var(--ink);color:#fff}.btn.solid:hover{background:var(--blue-2);border-color:var(--blue-2)}}
    .label{font-size:14px;color:var(--mid)}

    /* NAV */
    .nav{display:flex;align-items:center;justify-content:space-between;gap:16px;background:var(--grey);min-height:56px;padding:env(safe-area-inset-top) max(var(--g),env(safe-area-inset-right)) 0 max(var(--g),env(safe-area-inset-left))}
    .brand{font:500 22px/1 var(--display);letter-spacing:.005em;white-space:nowrap}
    .nav .links{display:none}
    .nav .door{display:inline-flex;align-items:center;min-height:44px;font:500 14px/1 var(--body);border-bottom:1px solid var(--ink)}
    .nav .door span{display:block;padding:6px 0}

    /* HERO, phone first: the picture cropped to the face, the stone and the hand, the words centred under it */
    .hero{background:var(--grey);position:relative}
    .hero .frame{position:relative;height:110.7vw;overflow:hidden}
    .hero .pic{position:absolute;width:182.86vw;aspect-ratio:3/2;left:-25vw;top:-7.14vw}
    .hero .pic img{width:100%;height:100%;max-width:none;object-fit:cover}
    .hero .tag{position:absolute;left:20%;bottom:11px;font-size:11px;line-height:1;color:#fff}
    .hero .words{text-align:center;padding:26px max(var(--g),env(safe-area-inset-right)) 36px max(var(--g),env(safe-area-inset-left))}
    .hero h1{font:400 clamp(36px,10.6vw,60px)/1 var(--display);letter-spacing:-.01em;margin:10px 0 14px}
    .hero h1 em{font-style:normal;color:var(--blue)}
    .hero .sub{font-size:16px;color:var(--ink);max-width:34ch;margin:0 auto 24px}
    .hero .doors{display:grid;gap:10px}
    .hero .marks{display:flex;flex-wrap:wrap;justify-content:center;list-style:none;margin:26px 0 0;padding:0;font-size:11px;color:var(--mid)}
    .hero .marks li{padding:0 8px;border-left:1px solid var(--line);line-height:1.2;margin:3px 0}
    .hero .marks li:first-child{border-left:0}

    /* THE SWITCHING PIECES: every picture sits in one fixed box and only its opacity changes, so nothing moves */
    .pieces{background:var(--paper);display:flex;flex-direction:column;gap:28px;padding:44px max(var(--g),env(safe-area-inset-right)) 48px max(var(--g),env(safe-area-inset-left))}
    .pieces .text{text-align:center}
    /* No product picture yet: the picture box is not shown at all and the words stand alone, centred */
    .pieces:not(:has(.slide[data-state="ok"])){display:block}
    .pieces:not(:has(.slide[data-state="ok"])) .switch{display:none}
    .pieces:not(:has(.slide[data-state="ok"])) .text{text-align:center;max-width:560px;margin-inline:auto}
    .pieces:not(:has(.slide[data-state="ok"])) .text p{margin-inline:auto}
    .pieces h2{font:400 34px/1.08 var(--display);letter-spacing:-.005em}
    .pieces .text p{font:400 20px/1.42 var(--display);max-width:30ch;margin:14px auto 26px}
    .pieces .text .btn{width:100%}
    .switch{order:-1;display:grid;grid-template-columns:48px minmax(0,1fr) 48px;align-items:center;row-gap:14px}
    .stage{grid-column:1/-1;grid-row:1;position:relative;aspect-ratio:1;background:var(--paper);touch-action:pan-y;user-select:none;-webkit-user-select:none}
    .slide{position:absolute;inset:0;opacity:0;transition:opacity .5s var(--ease)}
    .slide.on{opacity:1}
    .slide img{width:100%;height:100%;object-fit:contain;-webkit-user-drag:none}
    .slide .slot{display:none;position:absolute;inset:12%;border:1px solid var(--ink);flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;padding:16px}
    .slide .slot b{font:500 22px/1.1 var(--display)}
    .slide .slot small{font-size:12px;color:var(--mid);overflow-wrap:anywhere}
    .slide[data-state="empty"] .slot{display:flex}
    .slide[data-state="empty"] img,.slide:not([data-state]) img{display:none}
    .stage .tag{position:absolute;left:0;bottom:0;font-size:11px;line-height:1;color:var(--mid);opacity:0}
    .stage[data-shown="ok"] .tag{opacity:1}
    .caps{grid-column:1/-1;grid-row:2;display:grid;text-align:center}
    .cap{grid-area:1/1;font:500 21px/1.2 var(--display);opacity:0;transition:opacity .5s var(--ease)}
    .cap.on{opacity:1}
    .arrow{width:48px;height:48px;display:grid;place-items:center;border:1px solid var(--line);transition:border-color .18s var(--ease),background-color .18s var(--ease),color .18s var(--ease)}
    .arrow .ic{width:20px;height:20px}
    @media (hover:hover){.arrow:hover{border-color:var(--ink);background:var(--ink);color:#fff}}
    .arrow.prev{grid-column:1;grid-row:3}
    .arrow.next{grid-column:3;grid-row:3}
    .dots{grid-column:2;grid-row:3;display:flex;justify-content:center}
    .dots button{width:28px;height:44px;display:grid;place-items:center}
    .dots button::before{content:"";width:8px;height:8px;border:1px solid var(--ink);transition:background-color .18s var(--ease),border-color .18s var(--ease)}
    .dots button[aria-current="true"]::before{background:var(--blue);border-color:var(--blue)}
    .switch[data-count="1"] .arrow,.switch[data-count="1"] .dots{visibility:hidden}
    @media (prefers-reduced-motion:reduce){.slide,.cap{transition:none}}
    /* STONE PASSPORT and SHORTLIST (13 Nov): one card under the picture, rewritten as the piece changes; sample values */
    .pass{grid-column:1/-1;grid-row:4;border:1px solid var(--line);padding:16px;margin-top:6px;text-align:left}
    .pass .ph{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .pass .ph b{font:500 21px/1.1 var(--display)}
    .chip{font:500 11px/1 var(--body);color:var(--blue);border:1px solid var(--blue);padding:4px 6px}
    .pass dl{margin:12px 0 10px;border-bottom:1px solid var(--line)}
    .pass dl div{display:flex;justify-content:space-between;gap:16px;padding:8px 0;border-top:1px solid var(--line);font-size:14px}
    .pass dt,.compare dt{color:var(--mid)}
    .pass dd,.compare dd{margin:0;text-align:right}
    .pass .fine,.compare .fine{font-size:12px;color:var(--mid);margin:0 0 12px}
    .pass .btn{width:100%;min-height:46px}
    .btn[aria-pressed="true"]{background:var(--ink);color:#fff}
    .btn[aria-disabled="true"]{opacity:.45;cursor:default}
    .compare{border-top:1px solid var(--ink);padding-top:26px;text-align:left}
    .compare[hidden]{display:none}
    .compare h3{font:400 30px/1.1 var(--display);margin:8px 0 6px}
    .compare .cnote{font-size:14px;color:var(--mid);margin:0}
    .compare .cols{display:grid;grid-template-columns:repeat(var(--n,2),minmax(0,1fr));gap:8px;margin:18px 0 20px}
    .compare [data-col]{border:1px solid var(--line);padding:10px;display:flex;flex-direction:column;font-size:13px;min-width:0}
    .compare [data-col] img{width:100%;aspect-ratio:1;object-fit:contain}
    .compare [data-col] b{font:500 17px/1.15 var(--display);margin:8px 0 6px;min-height:3.45em}
    .compare dl{margin:0}
    .compare dl div{padding:6px 0;border-top:1px solid var(--line)}
    .compare dt{font-size:11px}
    .compare dd{text-align:left;overflow-wrap:anywhere}
    .compare [data-drop]{margin-top:auto;min-height:44px;font-size:13px;text-decoration:underline;text-underline-offset:4px;text-align:left}
    .compare .btn{width:100%}
    .compare .fine{margin:12px 0 0}
    @media (min-width:600px){.compare .btn{width:auto}.compare .cols{gap:20px;max-width:900px}.compare [data-col]{padding:16px;font-size:14px}.compare [data-col] b{font-size:21px;min-height:2.3em}}

    /* THE CLOSE-UP BAND: shown only when the close-up picture is in the folder. The band is the picture's own black and the stone is kept small (13 Nov), so no box edge shows and the facets stay sharp */
    .closeup{background:#000;color:#fff;display:grid;gap:44px;justify-items:center;text-align:center;margin:28px max(var(--g),env(safe-area-inset-right)) 44px max(var(--g),env(safe-area-inset-left));padding:44px 20px 44px}
    .closeup[hidden]{display:none}
    .closeup figure{position:relative;width:min(74vw,400px,var(--w,640px))}
    .closeup img{width:100%;height:auto;-webkit-mask-image:radial-gradient(ellipse 50% 50% at center,#000 93%,transparent 100%);mask-image:radial-gradient(ellipse 50% 50% at center,#000 93%,transparent 100%)}
    .closeup .tag{position:absolute;left:0;right:0;top:100%;margin-top:10px;font-size:11px;line-height:1;color:#b4b4b4;text-align:center}
    .closeup .label{color:#b4b4b4}
    .closeup h2{font:400 34px/1.06 var(--display);margin:10px 0 14px}
    .closeup .text p:last-child{color:#d6d6d6;max-width:34ch;margin:0 auto}
    /* THE RING: one pinned screen inside a track about two screens tall (three until 13 Nov). Without scripts or with reduced motion it is a still and three short texts */
    .ring{position:relative;background:var(--paper);height:210svh}
    .ring .pin{position:sticky;top:0;height:100svh;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;padding:calc(8svh + env(safe-area-inset-top)) max(var(--g),env(safe-area-inset-right)) 44px max(var(--g),env(safe-area-inset-left))}
    .ring .turn{position:relative;flex:0 0 auto;width:min(78vw,44svh,360px);aspect-ratio:1}
    .ring .turn img,.ring .turn canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
    .ring .turn canvas{opacity:0}
    .ring .turn [data-a]{top:-12.35%;height:112.35%}
    .ring .steps{display:grid;width:100%;text-align:center}
    .ring .step{grid-area:1/1;opacity:0;transition:opacity .4s var(--ease)}
    .ring .step.on{opacity:1}
    .ring h2{font:400 clamp(32px,9vw,48px)/1.04 var(--display);letter-spacing:-.005em;margin:8px 0 12px}
    .ring .line{max-width:32ch;margin:0 auto}
    .ring .note{position:absolute;left:var(--g);right:var(--g);bottom:calc(14px + env(safe-area-inset-bottom));text-align:center;font-size:11px;color:var(--mid)}
    .ring[data-still="true"]{height:auto}
    .ring[data-still="true"] .pin{position:static;height:auto;padding-top:56px;padding-bottom:64px}
    .ring[data-still="true"] .steps{gap:32px}
    .ring[data-still="true"] .step{grid-area:auto;opacity:1}
    @media (prefers-reduced-motion:reduce){.ring .step{transition:none}}
    /* WHAT DECIDES A SAPPHIRE: a plain list with hairlines, term then line */
    .know{background:var(--grey);padding:44px max(var(--g),env(safe-area-inset-right)) 48px max(var(--g),env(safe-area-inset-left))}
    .know .head{text-align:center}
    .know h2{font:400 34px/1.08 var(--display);letter-spacing:-.005em;margin:10px 0 12px}
    .know .aside{font-size:13px;color:var(--mid)}
    .know dl{margin:26px 0 0;border-bottom:1px solid var(--line)}
    .know h3{font:400 14px/1.3 var(--body);color:var(--mid);margin:30px 0 0}
    .know .asked{margin-top:12px;border-bottom:1px solid var(--line)}
    .know details{border-top:1px solid var(--line)}
    .know summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:56px;cursor:pointer;list-style:none;font:500 23px/1.15 var(--display)}
    .know summary::-webkit-details-marker{display:none}
    .know summary .ic{transition:transform .2s var(--ease)}
    .know details[open] summary .ic{transform:rotate(180deg)}
    .know details p{font-size:15px;line-height:1.5;margin:0 0 18px;max-width:56ch;text-wrap:pretty}
    .know dl div{display:grid;gap:4px;padding:16px 0;border-top:1px solid var(--line)}
    .know dt{font:500 23px/1.15 var(--display)}
    .know dd{margin:0;font-size:15px;line-height:1.5;text-wrap:pretty}
    @media (min-width:600px){
      .ring .turn{width:min(60vw,50svh,480px)}
      .know .body{max-width:640px;margin-left:auto;margin-right:auto}
    }
    @media (min-width:1100px){
      .closeup{grid-template-columns:minmax(0,1fr) minmax(0,1fr);justify-items:center;align-items:center;column-gap:0;text-align:left;margin:64px var(--g) 84px;padding:88px 0}
      .closeup .text{justify-self:start;width:min(480px,100% - var(--g))}
      .closeup figure{width:min(36vw,500px,var(--w,640px))}
      .closeup h2{font-size:52px;line-height:1.02;margin:14px 0 20px}
      .closeup .text p:last-child{font-size:18px;margin:0}
      .ring .pin{flex-direction:row;gap:7vw;padding:0 var(--g)}
      .ring .turn{width:min(40vw,60svh,560px)}
      .ring .steps{width:min(440px,34vw);text-align:left}
      .ring h2{font-size:clamp(48px,4.6vw,68px);line-height:1;margin:14px 0 20px}
      .ring .line{font-size:18px;margin:0}
      .ring .note{text-align:left;bottom:26px}
      .ring[data-still="true"] .pin{padding-top:84px;padding-bottom:84px}
      .know{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);column-gap:48px;align-items:start;padding:84px var(--g) 92px}
      .know .head{text-align:left;max-width:440px}
      .know h2{font-size:52px;line-height:1.02;margin:14px 0 20px}
      .know .body{margin:0;max-width:none}
      .know dl:first-child{margin-top:0}
      .know h3{margin-top:36px}
      .know summary{font-size:27px;min-height:64px}
      .know details p{font-size:16px}
      .know dl div{grid-template-columns:170px minmax(0,1fr);column-gap:32px;align-items:baseline;padding:20px 0}
      .know dt{font-size:27px}
      .know dd{font-size:16px;max-width:56ch}
    }
    /* THE CLOSE */
    .close{background:var(--grey);text-align:center;padding:52px max(var(--g),env(safe-area-inset-right)) calc(36px + env(safe-area-inset-bottom)) max(var(--g),env(safe-area-inset-left))}
    .close h2{font:400 clamp(36px,10vw,56px)/1.02 var(--display);letter-spacing:-.01em;margin:10px 0 28px}
    .close .btn{width:100%}
    .close .next{font-size:14px;line-height:1.5;color:var(--mid);max-width:36ch;margin:14px auto 0;text-wrap:pretty}
    .close .foot{margin-top:48px;padding-top:18px;border-top:1px solid var(--line);display:grid;gap:8px;font-size:12px;color:var(--mid)}
    .close .foot .brand{font-size:19px;color:var(--ink)}
    .close .facts{display:grid;grid-template-columns:1fr 1fr;gap:16px 12px;margin:14px 0 10px;font-size:13px}
    .close .facts dt{color:var(--mid);margin-bottom:2px}
    .close .facts dd{margin:0;color:var(--ink)}
    .close .facts a{display:inline-block;padding:6px 0;margin:-6px 0;text-decoration:underline;text-underline-offset:4px}

    /* TABLET: the whole picture, the words still centred under it */
    @media (min-width:600px){
      :root{--g:32px}
      .hero .frame{height:auto;aspect-ratio:3/2}
      .hero .pic{position:static;width:100%}
      .hero .tag{left:24.2%;bottom:4.5%}
      .hero .words{max-width:560px;margin:0 auto;padding-top:40px;padding-bottom:64px}
      .hero .doors{grid-template-columns:1fr 1fr}
      .hero .marks{font-size:13px}
      .hero .marks li{padding:0 14px}
      .pieces{padding-top:64px;padding-bottom:72px}
      .pieces .text .btn,.close .btn{width:auto}
      .switch{width:min(100%,560px);margin:0 auto}
    }

    /* DESK: its own layout. The picture is a stable box sized from the screen height, the words sit right of the hand,
       brand at the left gutter and the door at the right gutter. */
    @media (min-width:1100px){
      :root{--g:44px}
      .nav{position:absolute;z-index:2;top:0;left:0;right:0;min-height:64px;background:none}
      .nav .brand{color:#fff;font-size:24px}
      .nav .right{display:flex;align-items:center;gap:36px}
      .nav .links{display:flex;gap:28px;font-size:14px}
      .nav .links a{display:inline-flex;align-items:center;min-height:44px}
      @media (hover:hover){.nav .links a:hover{text-decoration:underline;text-underline-offset:5px}}
      .hero{--hh:clamp(560px,min(100svh,calc((100vw - 500px) / .98)),1040px);height:var(--hh);overflow:hidden}
      .hero .frame{position:absolute;aspect-ratio:auto;overflow:visible;height:calc(var(--hh) * 1.024);width:calc(var(--hh) * 1.536);left:calc(var(--hh) * -.1222);top:calc(var(--hh) * -.0089)}
      .hero .pic{width:100%;height:100%;-webkit-mask-image:linear-gradient(to right,#000 calc(100% - 110px),transparent);mask-image:linear-gradient(to right,#000 calc(100% - 110px),transparent)}
      .hero .words{position:absolute;margin:0;padding:0;text-align:left;left:calc(var(--hh) * .978 + 40px);right:var(--g);max-width:478px;top:50%;transform:translateY(-50%);container-type:inline-size}
      .hero h1{font-size:clamp(60px,22.6cqi,108px);line-height:.92;margin:18px 0 26px}
      .hero h1 span{display:block}
      .hero .sub{font-size:18px;max-width:30ch;margin:0 0 32px}
      .hero .doors{display:flex;flex-wrap:wrap;gap:12px}
      .hero .marks{justify-content:flex-start;margin-top:36px;font-size:13px}
      .hero .marks li:first-child{padding-left:0}

      .pieces{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:center;column-gap:48px;padding:84px var(--g) 92px}
      .pieces .text{text-align:left;max-width:440px}
      .pieces h2{font-size:52px;line-height:1.02}
      .pieces .text p{font-size:22px;margin:22px 0 34px}
      .switch{order:0;width:auto;margin:0;grid-template-columns:48px minmax(0,min(520px,62svh)) 48px;column-gap:32px;justify-content:center;row-gap:18px}
      .stage{grid-column:2}
      .caps{grid-column:2}
      .arrow.prev{grid-column:1;grid-row:1}
      .arrow.next{grid-column:3;grid-row:1}
      .dots{grid-column:2;grid-row:3}
      .pass{grid-column:2}
      .compare{grid-column:1/-1;margin-top:56px}

      .close{text-align:left;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;column-gap:48px;padding:88px var(--g) 40px}
      .close h2{font-size:clamp(56px,6vw,88px);line-height:.96;margin:14px 0 0;max-width:12ch}
      .close .act{max-width:340px}
      .close .next{margin:14px 0 0}
      .close .foot{grid-column:1/-1;margin-top:64px;grid-template-columns:auto 1fr;align-items:baseline;column-gap:32px}
      .close .foot{grid-template-columns:minmax(0,1fr) minmax(0,3fr)}
      .close .facts{grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin:0;font-size:14px}
      .close .foot p{grid-column:1/-1;margin-top:20px}
    }

    /* THE NEW SECTIONS (13 Nov): each one stays hidden until its picture is in the folder. Text starts on the left
       margin or on the exact middle of the screen (the half line from the scout). Headings rise once (scout pick 4). */
    [data-needs][hidden]{display:none}
    .story{background:var(--paper);display:grid}
    .story figure{position:relative}
    .story img,.room img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}
    .story .tag,.room .tag,.lights .tag{position:absolute;left:12px;bottom:10px;font-size:11px;line-height:1;color:var(--mid);background:var(--paper);padding:4px 6px}
    .story .text{padding:30px max(var(--g),env(safe-area-inset-right)) 44px max(var(--g),env(safe-area-inset-left));text-align:center}
    .story h2,.lights h2{font:400 34px/1.06 var(--display);letter-spacing:-.005em;margin:10px 0 14px}
    .story .text p:last-child,.lights .head p:last-child{font:400 20px/1.42 var(--display);max-width:32ch;margin:0 auto;text-wrap:pretty}
    .rise{display:block;overflow:hidden}
    .rise>span{display:block}
    .lights{background:var(--grey);padding:44px max(var(--g),env(safe-area-inset-right)) 48px max(var(--g),env(safe-area-inset-left))}
    .lights .head{text-align:center;margin-bottom:28px}
    .cmp{position:relative;aspect-ratio:3/2;overflow:hidden;touch-action:pan-y;user-select:none;-webkit-user-select:none;--p:50%;max-width:1100px;margin:0 auto;cursor:ew-resize}
    .cmp img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none}
    .cmp .top{clip-path:inset(0 calc(100% - var(--p)) 0 0)}
    .cmp .bar{position:absolute;top:0;bottom:0;left:var(--p);width:1px;background:var(--ink)}
    .cmp .grip{position:absolute;top:50%;left:var(--p);width:44px;height:44px;margin:-22px 0 0 -22px;background:var(--paper);border:1px solid var(--ink);display:grid;place-items:center;transition:transform .12s var(--ease)}
    .cmp .grip:active,.cmp[data-held] .grip{transform:scale(.92)}
    .lights .ends{display:flex;justify-content:space-between;max-width:1100px;margin:12px auto 0;font-size:14px;color:var(--mid)}
    .room{background:var(--grey);padding:0 max(var(--g),env(safe-area-inset-right)) 0 max(var(--g),env(safe-area-inset-left))}
    .room figure{position:relative;max-width:1352px;margin:0 auto}
    @media (prefers-reduced-motion:no-preference){
      [data-needs] .rise>span{transform:translateY(110%);transition:transform .8s cubic-bezier(.19,1,.22,1)}
      [data-needs] .rise:nth-child(2)>span{transition-delay:.08s}
      [data-needs].in .rise>span{transform:none}
    }
    @media (min-width:1100px){
      .story{grid-template-columns:1fr 1fr;align-items:center}
      .story img{aspect-ratio:auto;height:min(78svh,720px)}
      .story .text{text-align:left;padding:64px var(--g) 64px 0}
      .story.flip figure{order:2}
      .story.flip .text{padding:64px 48px 64px var(--g)}
      .story:not(.flip) .text{padding-left:0}
      .story:not(.flip) figure{margin-right:56px}
      .story h2,.lights h2{font-size:52px;line-height:1.02;margin:14px 0 20px}
      .story .text p:last-child{font-size:22px;margin:0;max-width:30ch}
      .lights{padding:84px var(--g) 92px}
      .lights .head{margin-bottom:48px}
      .lights .head p:last-child{font-size:22px}
      .room{padding-top:0}
    }
    /* FIND YOUR SAPPHIRE: four taps write the enquiry; the sentence is the feature */
    .finder{padding:48px max(var(--g),env(safe-area-inset-right)) 52px max(var(--g),env(safe-area-inset-left))}
    .finder .head{text-align:center}
    .finder h2{font:400 34px/1.08 var(--display);letter-spacing:-.005em;margin:10px 0 12px}
    .finder .head p:last-child{font:400 19px/1.45 var(--display);max-width:30ch;margin:0 auto}
    .finder fieldset{border:0;border-top:1px solid var(--line);margin:0;padding:18px 0 20px;min-width:0}
    .finder .pick{margin-top:30px}
    .finder legend{float:left;width:100%;padding:0;margin-bottom:12px;font-size:14px;color:var(--mid)}
    .finder legend small{font-size:12px;margin-left:6px}
    .finder .opts{clear:both;display:flex;flex-wrap:wrap;gap:8px}
    .finder .opt{position:relative}
    .finder .opt input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
    .finder .opt span{display:flex;align-items:center;gap:10px;min-height:46px;padding:0 16px;border:1px solid var(--line);font-size:15px;transition:border-color .18s var(--ease),background-color .18s var(--ease),color .18s var(--ease)}
    .finder .opt i{width:16px;height:16px;background:var(--sw);flex:none}
    .finder .opt input:checked+span{border-color:var(--ink);background:var(--ink);color:#fff}
    .finder .opt input:focus-visible+span{outline:2px solid var(--blue);outline-offset:2px}
    @media (hover:hover){.finder .opt input:not(:checked):hover+span{border-color:var(--ink)}}
    .finder .out{border-top:1px solid var(--ink);padding-top:22px}
    .finder .out .label{margin:0 0 8px}
    .finder .say{font:400 27px/1.18 var(--display);margin:0 0 22px;text-wrap:balance;min-height:2.4em}
    .finder .say b{font-weight:400;color:var(--blue)}
    .finder .btn{width:100%}
    .finder .fine{font-size:12px;color:var(--mid);margin:14px 0 0}
    /* THE PREVIEW (13 Nov): the choice is shown, not only written. A sticky strip on the phone, a panel under the words on the desk */
    .show{position:sticky;top:0;z-index:3;background:var(--paper);border-bottom:1px solid var(--line);margin:22px calc(-1 * max(var(--g),env(safe-area-inset-right))) 0 calc(-1 * max(var(--g),env(safe-area-inset-left)));padding:10px max(var(--g),env(safe-area-inset-right)) 10px max(var(--g),env(safe-area-inset-left));display:flex;align-items:center;gap:14px}
    .show[hidden]{display:none}
    .show .tiles{display:flex;gap:8px;flex:none}
    .show figure{width:76px;border:1px solid var(--line);background:var(--paper)}
    .show figure[hidden]{display:none}
    .show img{display:block;width:100%;aspect-ratio:1;object-fit:cover}
    .show figcaption{font-size:10px;line-height:1;color:var(--mid);padding:5px 0 6px;text-align:center;border-top:1px solid var(--line)}
    .show[data-blue="cornflower blue"] img{filter:url(#hop-light)}
    .show[data-blue="deep blue"] img{filter:url(#hop-deep)}
    .show .what{font:400 17px/1.2 var(--display);margin:0 0 5px;text-wrap:pretty}
    .show .tag{font-size:10px;line-height:1.3;color:var(--mid);margin:0}
    .show .said{min-width:0}
    .finder .opt input{scroll-margin-top:150px}
    .show+.pick{margin-top:0}
    .show+.pick fieldset:first-child{border-top:0}
    @media (min-width:600px) and (max-width:1099px){.show{max-width:640px;margin:26px auto 0;padding:10px 0}}
    @media (min-width:600px){.finder .pick{max-width:640px;margin-left:auto;margin-right:auto}.finder .btn{width:auto}}
    @media (min-width:1100px){
      .finder{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:0;align-items:start;padding:84px var(--g) 92px}
      .finder .head{text-align:left;max-width:440px}
      .finder h2{font-size:52px;line-height:1.02;margin:14px 0 20px}
      .finder .head p:last-child{font-size:22px;margin:0}
      .finder .pick{margin:0;max-width:none;grid-column:2;grid-row:1/3}
      .finder .head{grid-column:1;grid-row:1}
      .show{grid-column:1;grid-row:2;align-self:start;top:24px;margin:40px 0 0;padding:0;border:0;display:block;max-width:min(520px,calc(100% - 56px))}
      .show .tiles{display:grid;grid-template-columns:1fr 1fr;gap:12px}
      .show figure{width:auto}
      .show[data-one] figure{grid-column:1/-1;width:min(100%,340px)}
      .show figcaption{font-size:12px;padding:9px 0 10px}
      .show .what{font-size:24px;line-height:1.18;margin:18px 0 8px}
      .show .tag{font-size:12px}
      .show+.pick fieldset:first-child{border-top:1px solid var(--line)}
      .finder .say{font-size:38px;line-height:1.1;margin-bottom:28px}
    }
  </style>
</head>
<body>
<header class="nav">
  <a class="brand" href="#top">{HOUSE}</a>
  <div class="right">
    <nav class="links" aria-label="Sections"><a href="#pieces">Sapphires</a></nav>
    <a class="door" href="#viewing"><span>Arrange a viewing</span></a>
  </div>
</header>

<main id="top">
<section class="hero" aria-label="The house">
  <div class="frame">
    <figure class="pic"><img src="assets/one-pager/hero-start.webp" width="1536" height="1024" alt="A woman in profile looks at an oval blue sapphire held between her finger and thumb" fetchpriority="high" decoding="async"></figure>
    <span class="tag">Generated sample</span>
  </div>
  <div class="words">
    <p class="label">Master stonecutters of Ceylon</p>
    <h1><span>It begins </span><span>with <em>blue.</em></span></h1>
    <p class="sub">Sapphires cut by our own stonecutters, shown in daylight and lamplight before you decide.</p>
    <div class="doors">
      <a class="btn solid" href="#pieces">Explore sapphires <Fragment set:html={ic(arrowDownRaw)} /></a>
      <a class="btn" href="#viewing">Arrange a private viewing</a>
    </div>
    <ul class="marks"><li>Master cutting</li><li>Seen in two lights</li><li>By private appointment</li></ul>
  </div>
</section>

<section class="closeup" data-closeup hidden aria-labelledby="closeup-h">
  <figure><img data-base="assets/one-pager/products/closeup" alt="A blue sapphire seen close, its facets catching the light" decoding="async"><span class="tag">Generated sample</span></figure>
  <div class="text">
    <p class="label">Up close</p>
    <h2 id="closeup-h">The cut decides how the blue is seen.</h2>
    <p>Angles and proportions send the light back through the stone. That is the work of our stonecutters.</p>
  </div>
</section>
<section class="story" data-needs hidden aria-labelledby="craft-h">
  <figure><img data-pic data-base="assets/one-pager/products/s1-cutting" alt="A gem cutter's hands holding a sapphire to the cutting wheel" decoding="async"><span class="tag">Generated sample</span></figure>
  <div class="text">
    <p class="label">The cutting</p>
    <h2 id="craft-h"><span class="rise"><span>Cut by our</span></span><span class="rise"><span>own hands.</span></span></h2>
    <p>Each stone is shaped at the house's own wheel, one facet at a time, so the blue is bright from edge to edge.</p>
  </div>
</section>
<section class="ring" id="ring" data-ring data-still="true" data-frames="assets/motion/" aria-label="From a loose stone to a ring, in three steps">
  <div class="pin">
    <div class="turn" aria-hidden="true">
      <img data-poster src="assets/motion/hero-ring/ring-560-000.webp" width="560" height="560" alt="" loading="lazy" decoding="async">
      <canvas data-c width="560" height="560"></canvas>
      <canvas data-a width="560" height="629"></canvas>
    </div>
    <div class="steps">
      {STEPS.map(([label, head, line], i) => (
        <div class={i === 0 ? 'step on' : 'step'} data-step>
          <p class="label">{label}</p>
          <h2>{head}</h2>
          <p class="line">{line}</p>
        </div>
      ))}
    </div>
    <p class="note">Generated sample. A design study, not a claim about stock or availability.</p>
  </div>
</section>
<section class="story flip" data-needs hidden aria-labelledby="pair-h">
  <figure><img data-pic style="object-position:10% 50%" data-base="assets/one-pager/products/s6-portrait" alt="A woman with her eyes lowered, wearing a pair of blue sapphire stud earrings" decoding="async"><span class="tag">Generated sample</span></figure>
  <div class="text">
    <p class="label">A matched pair</p>
    <h2 id="pair-h"><span class="rise"><span>Two stones,</span></span><span class="rise"><span>one blue.</span></span></h2>
    <p>Stones for earrings are chosen side by side, so the colour reads the same on both.</p>
  </div>
</section>
<section class="lights" data-needs hidden aria-labelledby="lights-h">
  <div class="head">
    <p class="label">Seen in two lights</p>
    <h2 id="lights-h"><span class="rise"><span>Daylight and lamplight.</span></span></h2>
    <p>A sapphire changes with the light. Drag the line to see a stone by the window and under the lamp. At a viewing you see both before you decide.</p>
  </div>
  <figure class="cmp" data-cmp>
    <img data-pic data-base="assets/one-pager/products/s4-lamplight" alt="A blue sapphire in lamplight" decoding="async">
    <img class="top" data-pic data-base="assets/one-pager/products/s3-daylight" alt="A blue sapphire in daylight" decoding="async">
    <span class="bar" aria-hidden="true"></span>
    <span class="grip" role="slider" tabindex="0" aria-label="Compare the two lights" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-valuetext="50 per cent daylight"><Fragment set:html={ic(arrowRightRaw)} /></span>
    <span class="tag">Generated samples</span>
  </figure>
  <p class="ends"><span>Daylight</span><span>Lamplight</span></p>
</section>
<section class="know" aria-labelledby="know-h">
  <div class="head">
    <p class="label">How a sapphire is judged</p>
    <h2 id="know-h">What makes one sapphire worth more than another</h2>
    <p class="aside">General gem knowledge, not a description of any one stone.</p>
  </div>
  <div class="body">
    <dl>{KNOW.map(([term, line]) => <div><dt>{term}</dt><dd>{line}</dd></div>)}</dl>
    <h3>Three questions buyers ask</h3>
    <div class="asked">{ASKED.map(([term, line]) => <details><summary><span>{term}</span><Fragment set:html={ic(arrowDownRaw)} /></summary><p>{line}</p></details>)}</div>
  </div>
</section>
<section class="story" data-needs hidden aria-labelledby="loupe-h">
  <figure><img data-pic data-base="assets/one-pager/products/s7-jeweller" alt="A man studying a blue sapphire through a loupe, the stone held between his fingers" decoding="async"><span class="tag">Generated sample</span></figure>
  <div class="text">
    <p class="label">Under the loupe</p>
    <h2 id="loupe-h"><span class="rise"><span>Look closer</span></span><span class="rise"><span>than the eye can.</span></span></h2>
    <p>A loupe shows what the eye alone misses. At a viewing, ask to look through it yourself.</p>
  </div>
</section>
<section class="finder" id="find" aria-labelledby="find-h">
  <div class="head">
    <p class="label">Find your sapphire</p>
    <h2 id="find-h">Tell us what you <br>have in mind.</h2>
    <p>Four taps and you see your choice. The house reads your request before you arrive, so the right stones are on the table.</p>
  </div>
  <div class="show" data-show hidden>
    <div class="tiles">
      <figure data-tile="stone"><img data-stone alt="" decoding="async"><figcaption>Your stone</figcaption></figure>
      <figure data-tile="set" hidden><img data-set alt="" decoding="async"><figcaption>Set as</figcaption></figure>
    </div>
    <div class="said">
      <p class="what" data-what aria-live="polite"></p>
      <p class="tag">Generated sample. An illustration of your choice, not a stone in stock.</p>
    </div>
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute"><filter id="hop-light" color-interpolation-filters="sRGB"><feComponentTransfer><feFuncR type="gamma" exponent=".55"/><feFuncG type="gamma" exponent=".55"/><feFuncB type="gamma" exponent=".55"/></feComponentTransfer></filter><filter id="hop-deep" color-interpolation-filters="sRGB"><feComponentTransfer><feFuncR type="gamma" exponent="1.7"/><feFuncG type="gamma" exponent="1.7"/><feFuncB type="gamma" exponent="1.7"/></feComponentTransfer></filter></svg>
  </div>
  <form class="pick" data-finder data-wa={waBase} data-house={HOUSE}>
    <fieldset><legend>The shape</legend><div class="opts">
      <label class="opt"><input type="radio" name="shape" value="An oval" checked><span>Oval</span></label>
      <label class="opt"><input type="radio" name="shape" value="A cushion cut"><span>Cushion</span></label>
      <label class="opt"><input type="radio" name="shape" value="A round"><span>Round</span></label>
      <label class="opt"><input type="radio" name="shape" value="A pear cut"><span>Pear</span></label>
      <label class="opt"><input type="radio" name="shape" value=""><span>Not sure yet</span></label>
    </div></fieldset>
    <fieldset><legend>The blue</legend><div class="opts">
      <label class="opt"><input type="radio" name="blue" value="cornflower blue"><span><i style="--sw:#6f8fd8"></i>Cornflower</span></label>
      <label class="opt"><input type="radio" name="blue" value="royal blue" checked><span><i style="--sw:#1e3f8f"></i>Royal</span></label>
      <label class="opt"><input type="radio" name="blue" value="deep blue"><span><i style="--sw:#0f1f4d"></i>Deep</span></label>
      <label class="opt"><input type="radio" name="blue" value=""><span>Show me all three</span></label>
    </div></fieldset>
    <fieldset><legend>What it is for</legend><div class="opts">
      <label class="opt"><input type="radio" name="use" value="for a ring" checked><span>A ring</span></label>
      <label class="opt"><input type="radio" name="use" value="for a pair of earrings"><span>Earrings</span></label>
      <label class="opt"><input type="radio" name="use" value="for a pendant"><span>A pendant</span></label>
      <label class="opt"><input type="radio" name="use" value="as a loose stone"><span>A loose stone</span></label>
      <label class="opt"><input type="radio" name="use" value="as a gift"><span>A gift</span></label>
    </div></fieldset>
    <fieldset><legend>Your budget <small>Sample bands, until the house sets its own</small></legend><div class="opts">
      <label class="opt"><input type="radio" name="budget" value="under USD 1,000"><span>Under USD 1,000</span></label>
      <label class="opt"><input type="radio" name="budget" value="USD 1,000 to 5,000"><span>USD 1,000 to 5,000</span></label>
      <label class="opt"><input type="radio" name="budget" value="USD 5,000 to 15,000"><span>USD 5,000 to 15,000</span></label>
      <label class="opt"><input type="radio" name="budget" value="above USD 15,000"><span>Above USD 15,000</span></label>
      <label class="opt"><input type="radio" name="budget" value="" checked><span>Prefer not to say</span></label>
    </div></fieldset>
    <div class="out">
      <p class="label">Your request</p>
      <p class="say" data-say aria-live="polite"></p>
      <a class="btn solid" data-send href={wa(`Hello, from the ${HOUSE} page. I would like to arrange a private viewing.`)} target="_blank" rel="noopener">Send this on WhatsApp <Fragment set:html={ic(arrowOutRaw)} /></a>
