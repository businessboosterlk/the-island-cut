<script is:inline>
(() => {
  const root = document.querySelector('[data-switch]');
  if (!root) return;
  const EXT = ['jpg', 'png', 'jpeg', 'webp'];
  const stage = root.querySelector('[data-stage]');
  const slides = [...root.querySelectorAll('[data-slide]')];
  const caps = [...root.querySelectorAll('[data-cap]')];
  const dots = root.querySelector('[data-dots]');
  const ask = document.querySelector('[data-ask]');
  let live = slides.map((_, i) => i);
  let at = 0;
  // PASSPORT and SHORTLIST: the card under the picture follows the piece; up to three pieces can be set side by side.
  const items = JSON.parse(root.dataset.items || '[]'), rows = JSON.parse(root.dataset.passRows || '[]');
  const pass = root.querySelector('[data-pass]'), shortBtn = root.querySelector('[data-short]');
  const cmp = document.querySelector('[data-compare]'), cols = cmp && cmp.querySelector('[data-cols]'), cnote = cmp && cmp.querySelector('[data-cnote]'), csend = cmp && cmp.querySelector('[data-csend]');
  const MAX = 3; let picked = [];
  const esc = t => String(t).replace(/[&<>"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
  const card = () => {
    if (!pass) return;
    const on = live[at], it = items[on]; if (!it) return;
    rows.forEach(([k]) => { const d = pass.querySelector('[data-f="' + k + '"]'); if (d) d.textContent = it[k]; });
    const inList = picked.includes(on), full = picked.length >= MAX && !inList;
    shortBtn.textContent = inList ? 'Remove from shortlist' : full ? 'Shortlist full, three pieces' : 'Add to shortlist';
    shortBtn.setAttribute('aria-pressed', String(inList));
    shortBtn.setAttribute('aria-disabled', String(full));
  };
  const table = () => {
    if (!cmp) return;
    cmp.hidden = picked.length === 0;
    cols.style.setProperty('--n', String(Math.max(2, picked.length)));
    cols.innerHTML = picked.map(i => { const it = items[i], im = slides[i].querySelector('img');
      return '<div data-col><img src="' + esc(im.getAttribute('src') || '') + '" alt=""><b>' + esc(it.caption) + '</b><dl>' + rows.map(([k, l]) => '<div><dt>' + esc(l) + '</dt><dd>' + esc(it[k]) + '</dd></div>').join('') + '</dl><button type="button" data-drop="' + i + '" aria-label="Remove ' + esc(it.caption) + ' from the shortlist">Remove</button></div>'; }).join('');
    cnote.textContent = picked.length === 1 ? 'One piece so far. Add one more to compare.' : picked.length + ' pieces, sample passports side by side.';
    const names = picked.map(i => items[i].ref + ' (' + items[i].caption + ')');
    const list = names.length > 1 ? names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1] : names[0] || '';
    csend.href = root.dataset.wa + encodeURIComponent('Hello, from the ' + root.dataset.house + ' page. I am asking about ' + (names.length > 1 ? 'these pieces' : 'this piece') + ' on my shortlist: ' + list + '. I would like to arrange a private viewing.');
  };
  const toggle = i => { const k = picked.indexOf(i); if (k >= 0) picked.splice(k, 1); else if (picked.length < MAX) picked.push(i); else return; table(); card(); };
  if (shortBtn) shortBtn.addEventListener('click', () => toggle(live[at]));
  if (cols) cols.addEventListener('click', e => { const b = e.target.closest('[data-drop]'); if (b) toggle(Number(b.dataset.drop)); });

  // Look for each picture under every ending. Nothing is shown until a file answers.
  const probe = slide => new Promise(done => {
    const img = slide.querySelector('img');
    let k = 0;
    const next = () => {
      if (k >= EXT.length) { slide.dataset.state = 'empty'; return done(false); }
      const src = img.dataset.base + '.' + EXT[k++];
      const t = new Image();
      t.onload = () => { img.src = src; slide.dataset.state = 'ok'; done(true); };
      t.onerror = next;
      t.src = src;
    };
    next();
  });

  const show = n => {
    at = (n + live.length) % live.length;
    const on = live[at];
    slides.forEach((s, i) => { s.classList.toggle('on', i === on); s.setAttribute('aria-hidden', i === on ? 'false' : 'true'); });
    caps.forEach((c, i) => { c.classList.toggle('on', i === on); c.setAttribute('aria-hidden', i === on ? 'false' : 'true'); });
    [...dots.children].forEach((d, i) => d.setAttribute('aria-current', i === at ? 'true' : 'false'));
    stage.dataset.shown = slides[on].dataset.state || '';
    root.dataset.at = String(at + 1);
    if (ask) ask.href = root.dataset.wa + encodeURIComponent('Hello, from the ' + root.dataset.house + ' page. I am asking about this piece: ' + caps[on].textContent + (items[on] ? ', reference ' + items[on].ref : '') + '.');
    card();
  };

  const build = () => {
    dots.textContent = '';
    live.forEach((idx, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', 'Piece ' + (i + 1) + ' of ' + live.length + ': ' + caps[idx].textContent);
      b.addEventListener('click', () => show(i));
      dots.appendChild(b);
    });
    root.dataset.count = String(live.length);
    show(0);
  };

  root.querySelector('[data-prev]').addEventListener('click', () => show(at - 1));
  root.querySelector('[data-next]').addEventListener('click', () => show(at + 1));
  root.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
    else if (e.key === 'Home') { e.preventDefault(); show(0); }
    else if (e.key === 'End') { e.preventDefault(); show(live.length - 1); }
  });

  // Swipe: a sideways drag of 40 px or more on the picture.
  let x0 = null, y0 = 0;
  stage.addEventListener('pointerdown', e => { x0 = e.clientX; y0 = e.clientY; });
  stage.addEventListener('pointerup', e => {
    if (x0 === null) return;
    const dx = e.clientX - x0, dy = e.clientY - y0;
    x0 = null;
    if (Math.abs(dx) >= 40 && Math.abs(dx) > Math.abs(dy)) show(at + (dx < 0 ? 1 : -1));
  });
  stage.addEventListener('pointercancel', () => { x0 = null; });

  build();
  Promise.all(slides.map(probe)).then(found => {
    const ok = found.map((f, i) => f ? i : -1).filter(i => i >= 0);
    if (ok.length) live = ok;
    build(); table();
  });
})();
</script>
<script is:inline>
(() => {
  // THE CLOSE-UP: the band appears only when the picture is in the folder, at the picture's own width and no wider.
  const band = document.querySelector('[data-closeup]');
  if (band) {
    const img = band.querySelector('img'), EXT = ['jpg', 'jpeg', 'png', 'webp'];
    let k = 0;
    const next = () => {
      if (k >= EXT.length) { band.dataset.state = 'empty'; return; }
      const src = img.dataset.base + '.' + EXT[k++], t = new Image();
      t.onload = () => { img.src = src; img.width = t.naturalWidth; img.height = t.naturalHeight; band.style.setProperty('--w', t.naturalWidth + 'px'); band.hidden = false; band.dataset.state = 'ok'; };
      t.onerror = next;
      t.src = src;
    };
    next();
  }
  // THE RING: scroll is the only clock. Step 1 turns the ring, step 2 takes it apart and puts it back, step 3 turns it back to blue.
  const el = document.querySelector('[data-ring]');
  if (!el) return;
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const c = el.querySelector('[data-c]'), a = el.querySelector('[data-a]'), poster = el.querySelector('[data-poster]');
  const steps = [...el.querySelectorAll('[data-step]')];
  const base = el.dataset.frames, px = innerWidth >= 760 ? 1200 : 560, sets = {};
  let started = false, queued = false;
  const clamp = v => Math.max(0, Math.min(1, v)), ease = v => { v = clamp(v); return v * v * (3 - 2 * v); };
  const load = (name, path, n) => {
    const imgs = []; let left = n;
    for (let i = 0; i < n; i++) {
      const im = new Image();
      im.onload = () => { if (--left === 0) { sets[name] = imgs; el.dataset.loaded = Object.keys(sets).join(' '); ask(); } };
      im.onerror = () => { el.dataset.still = 'true'; };
      im.src = base + path + String(i).padStart(3, '0') + '.webp';
      imgs.push(im);
    }
  };
  const paint = (cv, imgs, f) => {
    const n = Math.round(clamp(f / (imgs.length - 1)) * (imgs.length - 1)), im = imgs[n];
    if (cv._n === n) return n;
    if (cv.width !== im.naturalWidth || cv.height !== im.naturalHeight) { cv.width = im.naturalWidth; cv.height = im.naturalHeight; }
    const x = cv.getContext('2d');
    x.clearRect(0, 0, cv.width, cv.height); x.drawImage(im, 0, 0); cv._n = n;
    return n;
  };
  const update = () => {
    queued = false;
    if (el.dataset.still === 'true') return;
    const travel = el.offsetHeight - innerHeight, p = clamp(-el.getBoundingClientRect().top / travel);
    const n = p < .3 ? 0 : p < .7 ? 1 : 2;
    let f = 59, af = -1;
    if (n === 0) f = 59 * ease(p / .3);
    else if (n === 1) { const q = (p - .3) / .4; af = 31 * (q < .5 ? ease(q / .4) : 1 - ease((q - .6) / .4)); }
    else f = 59 * (1 - ease((p - .7) / .26));
    steps.forEach((s, i) => s.classList.toggle('on', i === n));
    const split = af >= 0 && !!sets.apart;
    if (sets.turn) el.dataset.frame = String(paint(c, sets.turn, f));
    if (split) el.dataset.apart = String(paint(a, sets.apart, af)); else el.dataset.apart = '';
    c.style.opacity = sets.turn && !split ? '1' : '0';
    a.style.opacity = split ? '1' : '0';
    poster.style.opacity = sets.turn ? '0' : '1';
    el.dataset.step = String(n + 1);
  };
  const ask = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
  const start = () => { if (started) return; started = true; load('turn', 'hero-ring/ring-' + px + '-', 60); load('apart', 'journey/apart-' + px + '-', 32); };
  const mode = () => {
    el.dataset.still = String(calm.matches);
    if (calm.matches) { steps.forEach(s => s.classList.add('on')); return; }
    steps.forEach((s, i) => s.classList.toggle('on', i === 0));
    if ('IntersectionObserver' in window) new IntersectionObserver((es, io) => { if (es.some(e => e.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '100% 0px' }).observe(el);
    else start();
    ask();
  };
  calm.addEventListener('change', mode);
  addEventListener('scroll', ask, { passive: true });
  addEventListener('resize', ask);
  mode();
})();
</script>
<script is:inline>
(() => {
  // THE NEW SECTIONS: a section shows only when every picture it needs has answered; then its heading rises once.
  const EXT = ['jpg', 'png', 'jpeg', 'webp'];
  const find = img => new Promise(done => { let k = 0; const next = () => { if (k >= EXT.length) return done(false); const src = img.dataset.base + '.' + EXT[k++], t = new Image(); t.onload = () => { img.src = src; done(true); }; t.onerror = next; t.src = src; }; next(); });
  const io = 'IntersectionObserver' in window ? new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .25 }) : null;
  document.querySelectorAll('[data-needs]').forEach(sec => {
    Promise.all([...sec.querySelectorAll('[data-pic]')].map(find)).then(r => {
      if (!r.every(Boolean)) return;
      sec.hidden = false;
      io ? io.observe(sec) : sec.classList.add('in');
    });
  });
  // DRAG TO COMPARE (scout pick 1): one figure, the daylight picture clipped over the lamplight one.
  const cmp = document.querySelector('[data-cmp]');
  if (!cmp) return;
  const grip = cmp.querySelector('.grip');
  let v = 50, touched = false;
  const set = n => { v = Math.max(0, Math.min(100, n)); cmp.style.setProperty('--p', v + '%'); grip.setAttribute('aria-valuenow', String(Math.round(v))); grip.setAttribute('aria-valuetext', Math.round(v) + ' per cent daylight'); };
  const at = e => { const r = cmp.getBoundingClientRect(); set((e.clientX - r.left) / r.width * 100); };
  cmp.addEventListener('pointerdown', e => { touched = true; cmp.dataset.held = ''; cmp.setPointerCapture(e.pointerId); at(e); });
  cmp.addEventListener('pointermove', e => { if ('held' in cmp.dataset) at(e); });
  const up = () => { delete cmp.dataset.held; };
  cmp.addEventListener('pointerup', up); cmp.addEventListener('pointercancel', up);
  grip.addEventListener('keydown', e => {
    const step = { ArrowLeft: -2, ArrowRight: 2, PageDown: -10, PageUp: 10 }[e.key];
    if (step) { e.preventDefault(); touched = true; set(v + step); }
    else if (e.key === 'Home') { e.preventDefault(); touched = true; set(0); }
    else if (e.key === 'End') { e.preventDefault(); touched = true; set(100); }
  });
  // One nudge on first view: 22 points and back in 1.65 s after 0.45 s, stopped by the first touch.
  if (io && !matchMedia('(prefers-reduced-motion:reduce)').matches) new IntersectionObserver((es, o) => {
    if (!es.some(e => e.isIntersecting)) return; o.disconnect();
    setTimeout(() => { const t0 = performance.now(); const tick = t => { if (touched) return; const x = Math.min(1, (t - t0) / 1650); set(50 + 22 * Math.sin(Math.PI * x)); if (x < 1) requestAnimationFrame(tick); }; requestAnimationFrame(tick); }, 450);
  }, { threshold: .5 }).observe(cmp);
})();
</script>
<script is:inline>
(() => {
  // FIND YOUR SAPPHIRE: every tap rewrites the sentence and the WhatsApp message behind the button.
  const f = document.querySelector('[data-finder]'); if (!f) return;
  const say = f.querySelector('[data-say]'), send = f.querySelector('[data-send]');
  const val = n => (f.querySelector('input[name="' + n + '"]:checked') || {}).value || '';
  // THE PREVIEW: the shape picks the stone picture, the use picks the setting picture, the blue tints both. A picture that is not in the folder is never shown.
  const box = document.querySelector('[data-show]'), EXT = ['jpg', 'png', 'jpeg', 'webp'], got = {};
  const STONE = { 'An oval': ['p1-oval-sapphire', 'An oval stone'], 'A cushion cut': ['p2-cushion-sapphire', 'A cushion cut stone'], 'A round': ['p4-earrings', 'Round stones, shown here as a pair of earrings'], 'A pear cut': ['p5-pendant', 'A pear cut, shown here in a pendant'], '': ['p1-oval-sapphire', 'Shape still open, so an oval is shown'] };
  const SET = { 'for a ring': ['p3-ring', 'a ring'], 'for a pair of earrings': ['p4-earrings', 'earrings'], 'for a pendant': ['p5-pendant', 'a pendant'] };
  const look = name => new Promise(done => { let k = 0; const next = () => { if (k >= EXT.length) return done(); const src = 'assets/one-pager/products/' + name + '.' + EXT[k++], t = new Image(); t.onload = () => { got[name] = src; done(); }; t.onerror = next; t.src = src; }; next(); });
  const preview = (shape, blue, use) => {
    if (!box) return;
    const st = STONE[shape] || STONE[''], se = SET[use], a = got[st[0]], b = se && se[0] !== st[0] ? got[se[0]] : '';
    box.hidden = !a; if (!a) return;
    const si = box.querySelector('[data-stone]'), ti = box.querySelector('[data-set]');
    if (si.getAttribute('src') !== a) si.src = a;
    ti.parentNode.hidden = !b; if (b && ti.getAttribute('src') !== b) ti.src = b;
    if (b) delete box.dataset.one; else box.dataset.one = '';
    box.dataset.blue = blue; box.dataset.stone = st[0]; box.dataset.set = b ? se[0] : '';
    box.querySelector('[data-what]').textContent = st[1] + '. ' + (blue ? blue[0].toUpperCase() + blue.slice(1) + '. ' : 'Royal blue shown. ') + (b ? 'Set as ' + se[1] + ', a sample setting.' : se ? 'Set as ' + se[1] + '.' : 'Shown on its own.');
  };
  const draw = () => {
    const shape = val('shape'), blue = val('blue'), use = val('use'), budget = val('budget');
    const lead = shape ? shape + ' sapphire' : 'A sapphire';
    const tail = (shape ? '' : ' The shape is still open.') + (blue ? '' : ' I would like to see all three blues.') + (budget ? ' My budget is ' + budget + '.' : '');
    say.innerHTML = lead + (blue ? ' in <b>' + blue + '</b>' : '') + ', ' + use + '.' + tail;
    send.href = f.dataset.wa + encodeURIComponent('Hello, from the ' + f.dataset.house + ' page. I am looking for: ' + say.textContent + ' I would like to arrange a private viewing.');
    preview(shape, blue, use);
  };
  f.addEventListener('change', draw); f.addEventListener('submit', e => e.preventDefault()); draw();
  if (box) Promise.all(['p1-oval-sapphire', 'p2-cushion-sapphire', 'p3-ring', 'p4-earrings', 'p5-pendant'].map(look)).then(draw);
})();
</script>
