{
  "name": "the-island-cut",
  "private": true,
  "version": "0.1.0",
  "description": "A one page gem house website by Business Booster. Astro static site on the BB stack standard. Working name The Island Cut, held in src/config.js.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 4611",
    "build": "node scripts/build-icons.mjs --check && astro build",
    "preview": "node scripts/serve.mjs",
    "icons": "node scripts/build-icons.mjs",
    "check": "node scripts/check-site.mjs",
    "clicks": "node scripts/click-path.mjs",
    "shots": "node scripts/shots.mjs",
    "verify": "npm run build && npm run check && npm run clicks",
    "live": "node scripts/live.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "lucide-static": "^1.47.0",
    "playwright": "1.63.0",
    "simple-icons": "^16.32.0"
  }
}
